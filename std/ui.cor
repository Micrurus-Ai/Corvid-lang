# Browser views compose through ordinary functions and lists.
public type View:
    html: String

fn escaped(value: String) -> String:
    return value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")

fn children(views: List<View>) -> String:
    parts: List<String> = []
    for item in views:
        parts.append(item.html)
    return parts.join("")

public fn text(value: String) -> View:
    return View("<p>" + escaped(value) + "</p>")

public fn inline_text(value: String) -> View:
    return View(escaped(value))

public fn isolated_text(value: String) -> View:
    return View("<bdi>" + escaped(value) + "</bdi>")

public fn paragraph(content: List<View>) -> View:
    return View("<p>" + children(content) + "</p>")

public fn strong(content: List<View>) -> View:
    return View("<strong>" + children(content) + "</strong>")

public fn abbreviation(label: String, expansion: String) -> View:
    return View("<abbr title=\"" + escaped(expansion) + "\">" + escaped(label) + "</abbr>")

public fn data_value(value: String, content: List<View>) -> View:
    return View("<data value=\"" + escaped(value) + "\">" + children(content) + "</data>")

public fn time_value(datetime: String, content: List<View>) -> View:
    return View("<time datetime=\"" + escaped(datetime) + "\">" + children(content) + "</time>")

fn heading(tag: String, label: String) -> View:
    return View("<" + tag + ">" + escaped(label) + "</" + tag + ">")

public fn h1(label: String) -> View:
    return heading("h1", label)

public fn h2(label: String) -> View:
    return heading("h2", label)

public fn h3(label: String) -> View:
    return heading("h3", label)

public fn h4(label: String) -> View:
    return heading("h4", label)

public fn h5(label: String) -> View:
    return heading("h5", label)

public fn h6(label: String) -> View:
    return heading("h6", label)

# Insert an application-authored HTML fragment verbatim.
public fn trusted_markup(html: String) -> View:
    return View(html)

public fn data_group(name: String, value: String, content: List<View>) -> Result<View, String>:
    if name == "":
        return Err("A data attribute needs a name after data-.")
    allowed = "abcdefghijklmnopqrstuvwxyz0123456789-"
    for character in name:
        if not allowed.contains(character):
            return Err("Use lowercase ASCII letters, digits or hyphens in a data attribute name.")
    return Ok(View("<div data-" + name + "=\"" + escaped(value) + "\">" + children(content) + "</div>"))

public fn navigation(label: String, content: List<View>) -> View:
    return View("<nav aria-label=\"" + escaped(label) + "\">" + children(content) + "</nav>")

public fn aside(label: String, content: List<View>) -> View:
    return View("<aside aria-label=\"" + escaped(label) + "\">" + children(content) + "</aside>")

public fn section(heading_id: String, title: String, content: List<View>) -> View:
    id = escaped(heading_id)
    heading_html = "<h2 id=\"" + id + "\">" + escaped(title) + "</h2>"
    return View("<section aria-labelledby=\"" + id + "\">" + heading_html + children(content) + "</section>")

public fn image(src: String, alt: String) -> View:
    return View("<img src=\"" + escaped(src) + "\" alt=\"" + escaped(alt) + "\">")

public fn figure(caption: String, content: List<View>) -> View:
    return View("<figure>" + children(content) + "<figcaption>" + escaped(caption) + "</figcaption></figure>")

public fn list_item(content: List<View>) -> View:
    return View("<li>" + children(content) + "</li>")

public fn numbered_list_item(value: Int, content: List<View>) -> View:
    return View("<li value=\"" + value.to_string() + "\">" + children(content) + "</li>")

public fn ordered_list(start: Int, items: List<View>) -> View:
    return View("<ol start=\"" + start.to_string() + "\">" + children(items) + "</ol>")

public fn unordered_list(items: List<View>) -> View:
    return View("<ul>" + children(items) + "</ul>")

public fn table(caption: String, columns: List<String>, rows: List<List<View>>) -> View:
    return render_table(caption, columns, rows, false)

public fn table_with_row_headers(caption: String, columns: List<String>, rows: List<List<View>>) -> View:
    return render_table(caption, columns, rows, true)

fn render_table(caption: String, columns: List<String>, rows: List<List<View>>, row_headers: Bool) -> View:
    parts = ["<table><caption>" + escaped(caption) + "</caption><thead><tr>"]
    for column in columns:
        parts.append("<th scope=\"col\">" + escaped(column) + "</th>")
    parts.append("</tr></thead><tbody>")
    for cells in rows:
        parts.append("<tr>")
        needs_row_header = row_headers
        for cell in cells:
            if needs_row_header:
                parts.append("<th scope=\"row\">" + cell.html + "</th>")
                needs_row_header = false
            else:
                parts.append("<td>" + cell.html + "</td>")
        parts.append("</tr>")
    parts.append("</tbody></table>")
    return View(parts.join(""))

public fn stack(content: List<View>) -> View:
    return View("<div style=\"display:flex;flex-direction:column;gap:1rem\">" + children(content) + "</div>")

public fn row(content: List<View>) -> View:
    return View("<div style=\"display:flex;flex-wrap:wrap;align-items:center;gap:1rem\">" + children(content) + "</div>")

public fn grid(content: List<View>) -> View:
    return View("<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,16rem),1fr));gap:1rem\">" + children(content) + "</div>")

public fn text_field(label: String, name: String, initial: String) -> View:
    return View("<label>" + escaped(label) + "<input type=\"text\" name=\"" + escaped(name) + "\" value=\"" + escaped(initial) + "\"></label>")

public fn checkbox_field(label: String, name: String, checked: Bool) -> View:
    attributes = ""
    if checked:
        attributes = " checked"
    return View("<label><input type=\"checkbox\" name=\"" + escaped(name) + "\"" + attributes + ">" + escaped(label) + "</label>")

public fn text_area(label: String, name: String, initial: String) -> View:
    return text_area_with_requirement(label, name, initial, false)

public fn text_area_with_requirement(label: String, name: String, initial: String, required: Bool) -> View:
    attributes = ""
    if required:
        attributes = " required"
    # HTML parsers discard the first newline after a textarea start tag.
    return View("<label>" + escaped(label) + "<textarea name=\"" + escaped(name) + "\"" + attributes + ">\n" + escaped(initial) + "</textarea></label>")

public fn date_field(label: String, name: String, initial: String) -> View:
    return View("<label>" + escaped(label) + "<input type=\"date\" required name=\"" + escaped(name) + "\" value=\"" + escaped(initial) + "\"></label>")

# Pair one native field with a custom element that has a value property and a change event.
public fn bind_field(field: View, component: View) -> View:
    return View("<div data-corvid-bind-field>" + field.html + "<div hidden data-corvid-component>" + component.html + "</div></div>")

public fn submit(label: String) -> View:
    return View("<button type=\"submit\">" + escaped(label) + "</button>")

public fn reset_button(label: String) -> View:
    return View("<button type=\"reset\">" + escaped(label) + "</button>")

public fn post_form(path: String, controls: List<View>) -> View:
    return View("<form method=\"post\" action=\"" + escaped(path) + "\">" + children(controls) + "</form>")

# Expose a form with a text or HTML receipt to assistants. The person confirms submission in the browser.
public fn agent_post_form(name: String, description: String, path: String, controls: List<View>) -> View:
    attributes = " toolname=\"" + escaped(name) + "\" tooldescription=\"" + escaped(description) + "\""
    return View("<form method=\"post\" action=\"" + escaped(path) + "\"" + attributes + " data-corvid-receipt>" + children(controls) + "<output role='status'></output></form>")

public fn option(value: String, label: String, selected: Bool) -> View:
    attributes = ""
    if selected:
        attributes = " selected"
    return View("<option value=\"" + escaped(value) + "\"" + attributes + ">" + escaped(label) + "</option>")

# A change submits the surrounding native form once its event module attaches.
public fn submit_on_change_select(label: String, name: String, options: List<View>) -> View:
    return View("<label>" + escaped(label) + " <select name=\"" + escaped(name) + "\" data-corvid-submit-change>" + children(options) + "</select></label>")

# Each direct child has a stable application key. Movement controls attach in place.
public fn keyed_item(key: String, label: String, content: List<View>) -> View:
    earlier = "<button type=\"button\" data-corvid-move=\"up\" hidden>Move " + escaped(label) + " earlier</button>"
    later = "<button type=\"button\" data-corvid-move=\"down\" hidden>Move " + escaped(label) + " later</button>"
    return View("<li data-corvid-key=\"" + escaped(key) + "\">" + children(content) + earlier + later + "</li>")

public fn keyed_list(label: String, items: List<View>) -> View:
    return View("<div data-corvid-list><ol aria-label=\"" + escaped(label) + "\">" + children(items) + "</ol><span role=\"status\"></span></div>")

public fn browser_row(key: String, key_field: String, fields: Map<String, List<String>>, content: List<View>) -> View:
    editor = local_selection(browser_record(fields), stack(content), text(""))
    return keyed_item(key, key, [View("<div data-row-key-field=\"" + escaped(key_field) + "\">" + editor.html + "</div>")])

public fn browser_rows(label: String, rows: List<View>) -> View:
    return View("<div data-browser-rows><ol aria-label=\"" + escaped(label) + "\">" + children(rows) + "</ol><span role=\"status\"></span></div>")

public fn list_editor(rows: View, new_row: View, add_label: String, remove_label: String) -> View:
    add = "<button type=\"button\" data-add-row hidden>" + escaped(add_label) + "</button>"
    return View("<section data-list-editor data-remove-label=\"" + escaped(remove_label) + "\">" + rows.html + add + "<template>" + new_row.html + "</template></section>")

public fn assistant_reorder(component: View, name: String, description: String) -> View:
    return View("<div data-reorder-owner" + tool_attributes(name, description) + ">" + component.html + "</div>")

# A named native form control with an optional (Int) -> Int derived output.
public fn quantity_field(label: String, name: String, initial: Int, handler: String, result_label: String, initial_result: Int) -> View:
    field = "<label>" + escaped(label) + "<input type=\"text\" inputmode=\"numeric\" pattern=\"[0-9]{1,2}\" maxlength=\"2\" required name=\"" + escaped(name) + "\" value=\"" + initial.to_string() + "\" data-corvid-quantity=\"" + escaped(handler) + "\"></label>"
    return View("<div data-corvid-quantity-field>" + field + "<label hidden>" + escaped(result_label) + " <output>" + initial_result.to_string() + "</output></label><span role=\"alert\"></span></div>")

public fn search_form(controls: List<View>) -> View:
    return View("<form method=\"get\">" + children(controls) + "</form>")

public fn disclosure(label: String, content: List<View>) -> View:
    return disclosure_with_initial_state(label, false, content)

public fn disclosure_with_initial_state(label: String, initially_open: Bool, content: List<View>) -> View:
    attributes = ""
    if initially_open:
        attributes = " open"
    return View("<details" + attributes + "><summary>" + escaped(label) + "</summary>" + children(content) + "</details>")

fn document_page(html_attributes: String, title: String, head: String, content: List<View>) -> String:
    return "<!doctype html><html" + html_attributes + "><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>" + escaped(title) + "</title>" + head + "</head><body><main>" + children(content) + "</main></body></html>"

public fn page(title: String, content: List<View>) -> String:
    return document_page("", title, "", content)

public fn page_in_language(language: String, title: String, content: List<View>) -> String:
    return document_page(" lang=\"" + escaped(language) + "\"", title, "", content)

# Supply application-authored CSS, just as for a literal style element.
public fn styled_page(language: String, title: String, trusted_css: String, content: List<View>) -> String:
    return document_page(" lang=\"" + escaped(language) + "\"", title, "<style>" + trusted_css + "</style>", content)

public fn action(label: String, handler: String) -> View:
    return View("<button type=\"button\" data-corvid-action=\"" + escaped(handler) + "\" disabled>" + escaped(label) + "</button>")

# Opt this control into assistant discovery under a page-wide, stable tool name.
public fn assistant_action(label: String, handler: String, name: String, description: String) -> View:
    return View("<button type=\"button\" data-corvid-action=\"" + escaped(handler) + "\"" + tool_attributes(name, description) + " disabled>" + escaped(label) + "</button>")

fn tool_attributes(name: String, description: String) -> String:
    return " data-corvid-tool=\"" + escaped(name) + "\" data-corvid-description=\"" + escaped(description) + "\""

public fn int_state(label: String, initial: Int, controls: List<View>) -> View:
    return View("<fieldset data-corvid-state><legend>" + escaped(label) + "</legend><output>" + initial.to_string() + "</output>" + children(controls) + "<span role=\"alert\"></span></fieldset>")

# Give one integer control a page-wide name so other views can display its value.
public fn shared_int_state(name: String, label: String, initial: Int, controls: List<View>) -> View:
    return View("<div data-corvid-owner=\"" + escaped(name) + "\">" + int_state(label, initial, controls).html + "</div>")

public fn state_output(name: String, label: String) -> View:
    return View("<label>" + escaped(label) + " <output data-corvid-read=\"" + escaped(name) + "\"></output></label>")

public fn event_module() -> View:
    return View("<script type=\"module\" data-corvid-ui src=\"/target/wasm/events.js\"></script>")

public fn interactive_page(title: String, content: List<View>) -> String:
    return page(title, content + [event_module()])

public fn text_state(label: String, initial: String, handler: String) -> View:
    return text_control(label, initial, handler, "")

public fn assistant_text_state(label: String, initial: String, handler: String, name: String, description: String) -> View:
    return text_control(label, initial, handler, tool_attributes(name, description))

fn text_control(label: String, initial: String, handler: String, attributes: String) -> View:
    field = "<label>" + escaped(label) + "<input type=\"text\" value=\"" + escaped(initial) + "\" data-corvid-input=\"" + escaped(handler) + "\"" + attributes + " disabled></label>"
    return View("<fieldset data-corvid-state>" + field + "<output></output><span role=\"alert\"></span></fieldset>")

public fn fieldset(legend: String, controls: List<View>) -> View:
    return View("<fieldset><legend>" + escaped(legend) + "</legend>" + children(controls) + "</fieldset>")

# Submit named controls to an application-relative GET route.
public fn query_form(path: String, controls: List<View>) -> View:
    return View("<form method=\"get\" action=\"" + escaped(path) + "\">" + children(controls) + "</form>")

# Opt a read-only application query into declarative WebMCP discovery.
public fn agent_query_form(name: String, description: String, path: String, controls: List<View>) -> View:
    attributes = " toolname=\"" + escaped(name) + "\" tooldescription=\"" + escaped(description) + "\""
    return View("<form method=\"get\" action=\"" + escaped(path) + "\"" + attributes + ">" + children(controls) + "</form>")

# Navigate to an application route. Supply a trusted path from the application.
public fn link(label: String, path: String) -> View:
    return link_with_content(path, [inline_text(label)])

public fn link_with_content(path: String, content: List<View>) -> View:
    return View("<a href=\"" + escaped(path) + "\" tabindex=\"0\">" + children(content) + "</a>")

public fn stream_text(label: String, path: String) -> View:
    controls = "<button type=\"button\" data-start disabled>Start</button><button type=\"button\" data-cancel disabled>Cancel</button>"
    content = "<span role=\"status\">Ready</span><pre data-output></pre>"
    widget = "<corvid-text-stream data-path=\"" + escaped(path) + "\"><fieldset><legend>" + escaped(label) + "</legend>" + controls + content + "</fieldset></corvid-text-stream>"
    return View(widget + "<script type=\"module\" src=\"/.well-known/corvid/stream.js\"></script>")
# A Stroke carries two local pixel positions. Generated drag handlers project their
# coordinates onto the browser integer ABI.
public type Point:
    x: Int
    y: Int

public type Stroke:
    start: Point
    end: Point

fn drag_region(label: String, initial: Int, handler: String, control: String) -> View:
    return View("<fieldset data-corvid-drag=\"" + escaped(handler) + "\"><legend>" + escaped(label) + " <output>" + initial.to_string() + "</output></legend>" + control + "<span role=\"alert\"></span></fieldset>")

public fn drag_canvas(label: String, initial: Int, width: Int, height: Int, handler: String, draw: Bool) -> View:
    paint = ""
    if draw:
        paint = " data-corvid-line"
    control = "<canvas" + paint + " tabindex=\"0\" aria-label=\"Drawing surface. Drag or use arrow keys to draw.\" width=\"" + width.to_string() + "\" height=\"" + height.to_string() + "\" style=\"touch-action:none;outline:1px solid currentColor\"></canvas>"
    return drag_region(label, initial, handler, control)

public fn drag_panel(label: String, initial: Int, minimum: Int, maximum: Int, handler: String, content: List<View>) -> View:
    control = "<div data-corvid-panel style=\"box-sizing:border-box;display:flex;justify-content:space-between;border:1px solid currentColor;width:" + initial.to_string() + "px\"><div style=\"min-width:0;overflow:auto\">" + children(content) + "</div><span tabindex=\"0\" role=\"separator\" aria-label=\"Resize panel\" aria-orientation=\"vertical\" aria-valuemin=\"" + minimum.to_string() + "\" aria-valuemax=\"" + maximum.to_string() + "\" aria-valuenow=\"" + initial.to_string() + "\" style=\"width:1.25rem;min-height:2rem;background:ButtonFace;cursor:ew-resize;touch-action:none\"></span></div>"
    return drag_region(label, initial, handler, control)

# Explicitly expose this instance's drag action to a compatible assistant.
public fn assistant_drag(component: View, name: String, description: String) -> View:
    return View("<div data-corvid-drag-owner" + tool_attributes(name, description) + ">" + component.html + "</div>")

# A labelled integer control usable in forms and record selections.
public fn slider(label: String, name: String, value: Int, minimum: Int, maximum: Int) -> View:
    return View("<label>" + escaped(label) + "<input type=\"range\" name=\"" + escaped(name) + "\" value=\"" + value.to_string() + "\" min=\"" + minimum.to_string() + "\" max=\"" + maximum.to_string() + "\"></label>")

# Render a server-backed selection. Controls and initial preview are ordinary views.
public fn selection(path: String, controls: View, preview: View) -> View:
    return View("<form method=\"post\" action=\"" + escaped(path) + "\" data-corvid-selection>" + controls.html + "<button type=\"submit\">Apply</button><div data-corvid-preview role=\"status\">" + preview.html + "</div><span role=\"alert\"></span></form>")

public fn assistant_selection(component: View, name: String, description: String) -> View:
    return View("<div data-corvid-selection-owner" + tool_attributes(name, description) + ">" + component.html + "</div>")

public fn color_sample(red: Int, green: Int, blue: Int) -> View:
    color = "rgb(" + red.to_string() + ", " + green.to_string() + ", " + blue.to_string() + ")"
    return View("<span style=\"display:inline-block;width:3rem;height:2rem;background-color:" + color + "\" aria-hidden=\"true\"></span>")

public type IntegerField:
    name: String
    value: Int
    minimum: Int
    maximum: Int

public type RecordState:
    fields: List<IntegerField>
    descriptors: List<String>

public fn local_slider(label: String, name: String) -> View:
    return View("<label>" + escaped(label) + "<input disabled type=\"range\" name=\"" + escaped(name) + "\"></label>")

public fn record_text(pattern: String) -> View:
    return View("<span data-record-text=\"" + escaped(pattern) + "\"></span>")

# Display the current value of a bound browser field anywhere inside its editor.
public fn value(field: String) -> View:
    return record_text("{" + field + "}")

public fn boolean_children(field: String, content: List<View>) -> View:
    return View("<div hidden data-boolean-field=\"" + escaped(field) + "\">" + children(content) + "</div>")

public fn choice_children(field: String, variant: String, content: List<View>) -> View:
    return View("<div hidden data-choice-field=\"" + escaped(field) + "\" data-choice-variant=\"" + escaped(variant) + "\">" + children(content) + "</div>")

public fn record_swatch(red: String, green: String, blue: String) -> View:
    return View("<span data-record-swatch data-red=\"" + escaped(red) + "\" data-green=\"" + escaped(green) + "\" data-blue=\"" + escaped(blue) + "\" style=\"display:inline-block;width:3rem;height:2rem\" aria-hidden=\"true\"></span>")

public fn local_selection(state: RecordState, controls: View, preview: View) -> View:
    schema = ""
    for field in state.fields:
        schema = schema + "<i hidden data-field=\"" + escaped(field.name) + "\" data-value=\"" + field.value.to_string() + "\" data-min=\"" + field.minimum.to_string() + "\" data-max=\"" + field.maximum.to_string() + "\"></i>"
    for descriptor in state.descriptors:
        schema = schema + "<i hidden data-record-field=\"" + escaped(descriptor) + "\"></i>"
    return View("<fieldset data-local-selection>" + schema + controls.html + "<div role=\"status\" data-local-preview>" + preview.html + "</div><span role=\"alert\"></span></fieldset>")

# Build the editor descriptor from the compiler-checked browser state initializer.
public fn record_state(bounds: Map<String, List<Int>>) -> RecordState:
    fields: List<IntegerField> = []
    for name in bounds.keys():
        parts = bounds[name].unwrap_or([])
        fields.append(IntegerField(name, parts[0], parts[1], parts[2]))
    return RecordState(fields, [])

public fn browser_record(rows: Map<String, List<String>>) -> RecordState:
    fields: List<IntegerField> = []
    descriptors: List<String> = []
    for name in rows.keys():
        row = rows[name].unwrap_or([])
        if row[0] == "integer":
            fields.append(IntegerField(name, row[1].parse_int().unwrap_or(0), row[2].parse_int().unwrap_or(0), row[3].parse_int().unwrap_or(0)))
        else:
            descriptors.append(row[1])
    return RecordState(fields, descriptors)

public fn local_field(label: String, name: String) -> View:
    return field(label, name)

public fn field(label: String, name: String) -> View:
    return View("<label>" + escaped(label) + "<span data-local-field=\"" + escaped(name) + "\"></span></label>")
public fn local_checkbox(label: String, field: String) -> View:
    return checkbox(label, field)

public fn checkbox(label: String, field: String) -> View:
    return View("<label><input disabled type=\"checkbox\" name=\"" + escaped(field) + "\">" + escaped(label) + "</label>")

public fn segmented_choice(label: String, field: String) -> View:
    return View("<fieldset disabled data-choice-group=\"" + escaped(field) + "\"><legend>" + escaped(label) + "</legend><span data-options style=\"display:inline-flex;flex-wrap:wrap;border:1px solid currentColor;border-radius:0.35rem\"></span></fieldset>")
