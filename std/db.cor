# Standard database metadata envelopes.
#
# v1.0 scope (slice 33Q12a, maintainer-as-reviewer-2026-06-05 P3.2):
# this file ships the TYPED ENVELOPES — DbConnection, DbQuery,
# DbResult, DbParam, DbColumn, DbError, etc. — that describe a DB
# interaction. It does NOT ship a `db.query(...)` source-syntax
# primitive that compiles down to actual SQL execution. The
# `corvid migrate up` runtime DOES execute real SQL against SQLite
# and Postgres (Phase 35V2-P37 + Phase 35V2-P38 shipped the
# host-side runtime), but at v1.0 your application code reaches
# the runtime through a Corvid `tool` wrapper: declare a tool
# signature in your main.cor with `uses db_effect`, then implement
# the tool in your tools.py using `sqlite3` / `psycopg` / your DB
# client of choice. The envelopes below are the TYPED BOUNDARY
# between your agent and that tool — they carry redaction markers,
# effect envelopes, and replay keys so the moat features
# (replay-safety, audit-log grounding, effect-row composition)
# still apply across the bridge.
#
# Post-v1.0 (filed under `35V2-P39-I`-style source-syntax sugar
# slice): a `db.query("SELECT ...", params)` primitive lowers to
# the runtime directly without the tool wrapper. The envelopes
# in this file are the contract that primitive will produce; the
# v1.0 shape is forward-compatible with the post-v1.0 ergonomic
# layer.

import "./effects" use EffectEnvelope, effect_envelope

public type DbConnection:
    driver: String
    dsn: String
    replay_key: String
    effect_meta: EffectEnvelope

public type DbParam:
    name: String
    value_kind: String
    redacted: Bool
    # Phase 33S3b — value-carrying fields for the executing
    # SQLite surface (db_open/db_query/db_execute below). The
    # `value_kind` discriminator picks which of the four fields
    # below carries the bound value; others are zero-valued.
    # The runtime's `params_from_iter` reads only the field
    # matching `value_kind` — there is no SQL interpolation
    # path, so a literal `"'; DROP TABLE users; --"` placed in
    # `string_value` survives as text data and never reaches
    # SQLite's parser. The v1.0 metadata-only `db_param(...)`
    # constructor below zeros these fields; the new
    # `db_param_int` / `db_param_text` / `db_param_float` /
    # `db_param_bool` / `db_param_null` constructors set them.
    int_value: Int
    float_value: Float
    string_value: String
    bool_value: Bool

public type DbQuery:
    sql: String
    parameterized: Bool
    param_count: Int
    operation: String
    replay_key: String
    effect_meta: EffectEnvelope

public type DbResult:
    rows_affected: Int
    row_count: Int
    replay_key: String
    effect_meta: EffectEnvelope

public type DbError:
    query_site: String
    database_message: String
    redacted: Bool

public type DbColumn:
    name: String
    expected_type: String
    value_kind: String
    present: Bool

public type DbRowDecode:
    record_type: String
    ok: Bool
    field_path: String
    expected_type: String
    received_kind: String
    message: String

public type DbTransaction:
    id: String
    status: String
    nested: Bool
    replay_key: String
    effect_meta: EffectEnvelope

public type DbAuditRecord:
    actor: String
    action: String
    subject: String
    route_name: String
    job_id: String
    agent_name: String
    prompt_version: String
    model_id: String
    tool_name: String
    approval_state: String
    cost_usd: Float
    trace_id: String
    replay_key: String
    effect_meta: EffectEnvelope

public type DbAuditWrite:
    record: DbAuditRecord
    approval_required: Bool
    value_redacted: Bool
    replay_key: String
    effect_meta: EffectEnvelope

public type DbTokenRef:
    provider: String
    account_id: String
    token_id: String
    key_id: String
    redacted: Bool
    replay_key: String
    effect_meta: EffectEnvelope

public type DbEncryptedToken:
    token_ref: DbTokenRef
    ciphertext_hash: String
    algorithm: String
    key_id: String
    replay_key: String
    effect_meta: EffectEnvelope

public type DbMigrationStatus:
    driver: String
    migration: String
    checksum: String
    status: String
    drifted: Bool
    replay_key: String
    effect_meta: EffectEnvelope

public type DbEffectTag:
    operation: String
    effect_name: String
    replay_key: String
    effect_meta: EffectEnvelope

public type DbReplaySummary:
    operation: String
    driver: String
    query_fingerprint: String
    row_count: Int
    rows_affected: Int
    redacted: Bool
    replay_key: String
    effect_meta: EffectEnvelope

public agent sqlite_open(dsn: String, replay_key: String) -> DbConnection:
    return DbConnection("sqlite", dsn, replay_key, effect_envelope("std.db.open", "", "", "", replay_key))

public agent postgres_open(dsn: String, replay_key: String) -> DbConnection:
    return DbConnection("postgres", dsn, replay_key, effect_envelope("std.db.open", "", "", "", replay_key))

# Phase 33S3b — metadata-only `db_param` constructor (v1.0
# envelope shape). Zeros the new value-carrying fields; for the
# executing surface use the typed `db_param_int` / `db_param_text`
# / etc. constructors below.
public agent db_param(name: String, value_kind: String, redacted: Bool) -> DbParam:
    return DbParam(name, value_kind, redacted, 0, 0.0, "", false)

# Phase 33S3b — typed value constructors for the executing
# SQLite surface. The runtime's `params_from_iter` reads only
# the field matching `value_kind`, so a literal string with SQL
# syntax in `string_value` survives as data — never interpolated.
public agent db_param_int(value: Int) -> DbParam:
    return DbParam("", "Int", false, value, 0.0, "", false)

public agent db_param_float(value: Float) -> DbParam:
    return DbParam("", "Float", false, 0, value, "", false)

public agent db_param_text(value: String) -> DbParam:
    return DbParam("", "String", false, 0, 0.0, value, false)

public agent db_param_bool(value: Bool) -> DbParam:
    return DbParam("", "Bool", false, 0, 0.0, "", value)

public agent db_param_null() -> DbParam:
    return DbParam("", "Null", false, 0, 0.0, "", false)

# Phase 33S3b — these envelope-builder agents were renamed from
# `db_query` / `db_execute` to `db_request_query` /
# `db_request_execute` so the unprefixed names host the
# executing tools below. Mirrors the 33S2a rename of HTTP
# envelope agents (http_get → http_request_get etc.).
public agent db_request_query(sql: String, param_count: Int, replay_key: String) -> DbQuery:
    return DbQuery(sql, true, param_count, "read", replay_key, effect_envelope("std.db.query", "", "", "", replay_key))

public agent db_request_execute(sql: String, param_count: Int, replay_key: String) -> DbQuery:
    return DbQuery(sql, true, param_count, "write", replay_key, effect_envelope("std.db.execute", "", "", "", replay_key))

public agent db_result(rows_affected: Int, row_count: Int, replay_key: String) -> DbResult:
    return DbResult(rows_affected, row_count, replay_key, effect_envelope("std.db.result", "", "", "", replay_key))

public agent db_error(query_site: String, database_message: String) -> DbError:
    return DbError(query_site, database_message, true)

public agent db_parameterized(query: DbQuery) -> Bool:
    return query.parameterized and query.param_count >= 0

public agent db_column(name: String, expected_type: String, value_kind: String, present: Bool) -> DbColumn:
    return DbColumn(name, expected_type, value_kind, present)

public agent db_decode_ok(record_type: String) -> DbRowDecode:
    return DbRowDecode(record_type, true, "", "", "", "")

public agent db_decode_missing_column(record_type: String, field_path: String, expected_type: String) -> DbRowDecode:
    return DbRowDecode(record_type, false, field_path, expected_type, "missing", "missing column")

public agent db_decode_wrong_kind(record_type: String, field_path: String, expected_type: String, received_kind: String) -> DbRowDecode:
    return DbRowDecode(record_type, false, field_path, expected_type, received_kind, "wrong value kind")

public agent db_transaction(id: String, status: String, nested: Bool, replay_key: String) -> DbTransaction:
    return DbTransaction(id, status, nested, replay_key, effect_envelope("std.db.transaction", "", "", "", replay_key))

public agent db_transaction_commit(tx: DbTransaction) -> DbTransaction:
    return DbTransaction(tx.id, "committed", tx.nested, tx.replay_key, tx.effect_meta)

public agent db_transaction_rollback(tx: DbTransaction) -> DbTransaction:
    return DbTransaction(tx.id, "rolled_back", tx.nested, tx.replay_key, tx.effect_meta)

public agent db_transaction_nested_rejected(tx: DbTransaction) -> Bool:
    return tx.nested

public agent db_audit_record(actor: String, action: String, subject: String, route_name: String, job_id: String, agent_name: String, prompt_version: String, model_id: String, tool_name: String, approval_state: String, cost_usd: Float, trace_id: String, replay_key: String) -> DbAuditRecord:
    return DbAuditRecord(actor, action, subject, route_name, job_id, agent_name, prompt_version, model_id, tool_name, approval_state, cost_usd, trace_id, replay_key, effect_envelope("std.db.audit", "", actor, subject, replay_key))

public agent db_audit_approved(record: DbAuditRecord) -> Bool:
    return record.approval_state == "approved"

public agent db_audit_write(record: DbAuditRecord, approval_required: Bool, value_redacted: Bool) -> DbAuditWrite:
    return DbAuditWrite(record, approval_required, value_redacted, record.replay_key, effect_envelope("std.db.audit.write", "", record.actor, record.subject, record.replay_key))

public agent db_audit_write_safe(write: DbAuditWrite) -> Bool:
    return write.value_redacted and (not write.approval_required or write.record.approval_state == "approved")

public agent db_token_ref(provider: String, account_id: String, token_id: String, key_id: String, replay_key: String) -> DbTokenRef:
    return DbTokenRef(provider, account_id, token_id, key_id, true, replay_key, effect_envelope("std.db.token.ref", "", account_id, token_id, replay_key))

public agent db_encrypted_token(token_ref: DbTokenRef, ciphertext_hash: String, algorithm: String) -> DbEncryptedToken:
    return DbEncryptedToken(token_ref, ciphertext_hash, algorithm, token_ref.key_id, token_ref.replay_key, effect_envelope("std.db.token.encrypted", "", token_ref.account_id, token_ref.token_id, token_ref.replay_key))

public agent db_token_redacted(token_ref: DbTokenRef) -> Bool:
    return token_ref.redacted

public agent db_migration_status(driver: String, migration: String, checksum: String, status: String, drifted: Bool, replay_key: String) -> DbMigrationStatus:
    return DbMigrationStatus(driver, migration, checksum, status, drifted, replay_key, effect_envelope("std.db.migration.status", "", driver, migration, replay_key))

public agent db_migration_clean(status: DbMigrationStatus) -> Bool:
    return not status.drifted

public agent db_effect_tag(operation: String, replay_key: String) -> DbEffectTag:
    return DbEffectTag(operation, "std.db." + operation, replay_key, effect_envelope("std.db.effect", "", operation, "", replay_key))

public agent db_effect_is_write(tag: DbEffectTag) -> Bool:
    return tag.operation == "write" or tag.operation == "migration" or tag.operation == "token" or tag.operation == "audit"

public agent db_replay_summary(operation: String, driver: String, query_fingerprint: String, row_count: Int, rows_affected: Int, replay_key: String) -> DbReplaySummary:
    return DbReplaySummary(operation, driver, query_fingerprint, row_count, rows_affected, true, replay_key, effect_envelope("std.db.replay", "", driver, query_fingerprint, replay_key))

public agent db_replay_redacted(summary: DbReplaySummary) -> Bool:
    return summary.redacted

# ----------------------------------------------------------------
# Phase 33S3 — executing SQLite surface.
#
# These three `tool` declarations are the user-facing entry
# points for actual SQLite operations. They flow through the
# typed effect system (`uses db_egress_open` etc.) so the
# checker tracks `io_source: db.read / db.write` on every
# caller, and the runtime enforces:
#
#   * `[io] root` confinement on `db_open` — the resolved path
#     must stay inside the configured root (the same boundary
#     the io_*_text tools enforce). The documented special case
#     `":memory:"` bypasses confinement because there is no
#     filesystem path to confine. Calling `db_open` without
#     `[io] root` set fails closed with the missing-config
#     diagnostic.
#   * Parameter-bound only — all SQL parameters flow through
#     `rusqlite::params_from_iter` over typed `DbValue`s. There
#     is no string-interpolation path; a literal `"'; DROP
#     TABLE users; --"` placed in `string_value` survives as
#     text data without ever being parsed as SQL. The 33S3b
#     plumbing test `db_param_text_with_sql_metacharacters_is_bound_as_data`
#     pins this property.
#   * Replay quarantine — `db_execute` during Substitute-mode
#     replay refuses with `QuarantineViolation { surface: "db",
#     .. }` regardless of statement contents. `db_query` reads
#     pass through (sqlite reads don't escape the process; the
#     trace-substitution path 33S3c integrates is the upper
#     gate). `db_open` opens a fresh connection — 33S3c will
#     refine this so replay reuses a captured connection state
#     from the recorded trace.
#
# All three are tools (not agents), so they are automatically
# rejected inside `@deterministic` bodies by the checker's
# declaration-kind classifier — calling any SQLite operation
# from a `@deterministic` agent is a compile error.
# ----------------------------------------------------------------

# The three SQLite effect rows. Registered as built-ins by
# `crates/corvid-types/src/effects.rs::register_db_effects` so
# composing checkers can compose them across calls; declared
# inline here so the resolver in standalone-module compilation
# sees them as named identifiers. Named `db_egress_*` so the
# tool names (`db_open` / `db_query` / `db_execute`) don't
# collide with the effect names — effects and tools share a
# namespace at the resolver level (same trap as 33S2's HTTP
# rename and 33S1's IO rename).
public effect db_egress_open:
    reversible: true

public effect db_egress_read:
    reversible: true

public effect db_egress_write:
    reversible: false

# Slice 47h: honest Result envelopes. A missing/corrupt database
# file, an SQL error, or a parameter-binding failure is an Err
# VALUE naming the cause — never a trap.
public tool db_open(path: String) -> Result<DbHandle, String> uses db_egress_open
public tool db_query(handle: DbHandle, sql: String, params: List<DbParam>) -> Result<List<DbResult>, String> uses db_egress_read
public tool db_execute(handle: DbHandle, sql: String, params: List<DbParam>) -> Result<DbResult, String> uses db_egress_write
