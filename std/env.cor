# Read process configuration through the runtime's existing environment tool.
import "./secrets" use secret_read

public agent env_get(name: String) -> Result<Option<String>, String>:
    if name.trim().length() == 0 or name.contains("=") or name.contains("\0"):
        return Err("environment variable names must be nonempty and cannot contain '=' or NUL")
    entry = secret_read(name)?
    if entry.present:
        return Ok(Some(entry.value))
    return Ok(None)
