# Standard HTTP data envelopes.

import "./effects" use EffectEnvelope, effect_envelope

public type HttpHeader:
    name: String
    value: String

public type HttpRequestEnvelope:
    method_name: String
    url: String
    body: String
    timeout_ms: Int
    max_retries: Int
    effect_meta: EffectEnvelope

public type HttpResponseEnvelope:
    status: Int
    body: String
    attempts: Int
    elapsed_ms: Int
    effect_meta: EffectEnvelope

# 33S2a (2026-06-08) — these envelope-builder agents were
# renamed from `http_get` / `http_post_json` to
# `http_request_get` / `http_request_post_json` so the
# unprefixed names can host the new executing tools below.
# Building a request and PERFORMING a GET are two different
# operations; naming both `http_get` was a library-convention
# carryover that Corvid's "language-not-SDK" pitch rejects.
public agent http_request_get(url: String) -> HttpRequestEnvelope:
    return HttpRequestEnvelope("GET", url, "", 30000, 0, effect_envelope("std.http.request", "", "", "", "std.http.request"))

public agent http_request_post_json(url: String, body: String) -> HttpRequestEnvelope:
    return HttpRequestEnvelope("POST", url, body, 30000, 0, effect_envelope("std.http.request", "", "", "", "std.http.request"))

public agent http_with_retry(request: HttpRequestEnvelope, max_retries: Int) -> HttpRequestEnvelope:
    return HttpRequestEnvelope(request.method_name, request.url, request.body, request.timeout_ms, max_retries, request.effect_meta)

public agent http_with_timeout(request: HttpRequestEnvelope, timeout_ms: Int) -> HttpRequestEnvelope:
    return HttpRequestEnvelope(request.method_name, request.url, request.body, timeout_ms, request.max_retries, request.effect_meta)

public agent http_ok(response: HttpResponseEnvelope) -> Bool:
    return response.status >= 200 and response.status < 300

# ----------------------------------------------------------------
# Making HTTP requests.
#
# A program calls another service through a `connector`, which
# declares where requests go, how long they may take, which
# redirects they follow and how they authenticate. To call a URL
# the program learns at run time, declare
#
#     connector web:
#         hosts: allowed_hosts
#         timeout: 10s
#         redirects: allowed_hosts
#         modes: [real, replay]
#         operation fetch(url: String) -> Response<String> uses http_egress_get:
#             GET url
#             response: text
#
# Every request runs the structural SSRF block and the project's
# `[http] allow` list, and replay never reaches the network. The
# `http_get` and `http_post_json` tools this module once declared
# are replaced by connectors (B05); see the HTTP client proposal.
# ----------------------------------------------------------------

# The two built-in network-egress effects, for connector operations
# that do not declare their own. Registered as built-ins by
# `crates/corvid-types/src/effects.rs::register_http_effects`;
# declared here so standalone-module compilation resolves the names.
public effect http_egress_get:
    reversible: true

public effect http_egress_post:
    reversible: false
