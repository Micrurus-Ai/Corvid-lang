# Standard secret access envelopes + the executing read surface.
#
# Disposition: EXECUTING. `secret_read` reads an environment-backed
# secret through the runtime's `secrets::SecretRuntime` with a
# replay-safe trace contract:
#
#   - The PROGRAM receives the real value (the `value` field).
#   - The TRACE never does: the recorded ToolResult carries a
#     redacted copy (`value_redacted: true`, value replaced by the
#     `<redacted:..>` marker). Traces must never persist secret
#     values.
#   - REPLAY re-executes the env read instead of substituting from
#     the trace — the same read-passthrough rule `db_query` follows
#     (env reads are process-internal inputs; they cannot escape).
#     If the environment differs at replay time, the run diverges
#     HONESTLY instead of replaying a value the trace never stored.
#
# Residual channel (explicit non-scope): a secret the program
# forwards into ANOTHER tool's arguments is recorded by that tool's
# own trace events. The structural fix — an opaque SecretHandle
# value that never serializes, accepted by consuming surfaces — is
# the tracked post-v1.0 deepening.

import "./effects" use EffectEnvelope, effect_envelope

public type SecretReadEnvelope:
    name: String
    present: Bool
    value: String
    value_redacted: Bool
    effect_meta: EffectEnvelope

public effect secrets_read:
    reversible: true

# Recoverable failures (empty name, unreadable variable) are Err
# VALUES; a MISSING secret is Ok with `present: false` — absence is
# a modeled state, not an error.
public tool secret_read(name: String) -> Result<SecretReadEnvelope, String> uses secrets_read

public agent secret_present(name: String, value: String) -> SecretReadEnvelope:
    return SecretReadEnvelope(name, true, value, false, effect_envelope("std.secrets.read", "", "secrets.read", "", "std.secrets.read"))

public agent secret_missing(name: String) -> SecretReadEnvelope:
    return SecretReadEnvelope(name, false, "", false, effect_envelope("std.secrets.read", "", "secrets.read", "", "std.secrets.read"))
