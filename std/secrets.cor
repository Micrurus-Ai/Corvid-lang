# Standard secret access envelopes.
#
# Disposition: CONTRACT-ONLY — non-executing today, for a
# designed reason: an executing `secret_read` tool would record
# its result into the trace, and traces must NEVER persist secret
# values (note this envelope carries `present` / `value_redacted`
# but no value field). The runtime ships the real reader
# (corvid-runtime `secrets::SecretRuntime`, env-backed, with
# redacted audit metadata); reach it through a host tool wrapper
# that returns only what your program needs. A replay-safe
# executing secret surface (redacted recording + re-read on
# replay) is a tracked roadmap candidate.

import "./effects" use EffectEnvelope, effect_envelope

public type SecretReadEnvelope:
    name: String
    present: Bool
    value_redacted: Bool
    effect_meta: EffectEnvelope

public agent secret_present(name: String) -> SecretReadEnvelope:
    return SecretReadEnvelope(name, true, true, effect_envelope("std.secrets.read", "", "secrets.read", "", "std.secrets.read"))

public agent secret_missing(name: String) -> SecretReadEnvelope:
    return SecretReadEnvelope(name, false, false, effect_envelope("std.secrets.read", "", "secrets.read", "", "std.secrets.read"))
