# Standard retrieval-augmented generation envelopes.

import "./effects" use EffectEnvelope, effect_envelope

public type RagDocumentEnvelope:
    id: String
    source: String
    media_type: String
    text: String
    effect_meta: EffectEnvelope

public type RagChunkEnvelope:
    doc_id: String
    chunk_id: String
    source: String
    text: String
    start_char: Int
    end_char: Int
    provenance_key: String
    effect_meta: EffectEnvelope

public type RetrievedRagChunkEnvelope:
    chunk: RagChunkEnvelope
    grounded: Bool
    source_name: String

public type EmbedderEnvelope:
    provider: String
    model_name: String
    endpoint: String
    effect_meta: EffectEnvelope

public agent rag_document(id: String, source: String, media_type: String, text: String) -> RagDocumentEnvelope:
    return RagDocumentEnvelope(id, source, media_type, text, effect_envelope("std.rag.document", "", "", "", "std.rag.document"))

public agent rag_chunk(doc_id: String, chunk_id: String, source: String, text: String, start_char: Int, end_char: Int, provenance_key: String) -> RagChunkEnvelope:
    return RagChunkEnvelope(doc_id, chunk_id, source, text, start_char, end_char, provenance_key, effect_envelope("std.rag.chunk", provenance_key, "", "", "std.rag.chunk"))

public agent retrieved_chunk(chunk: RagChunkEnvelope, source_name: String) -> RetrievedRagChunkEnvelope:
    return RetrievedRagChunkEnvelope(chunk, chunk.provenance_key != "", source_name)

public agent openai_embedder(model_name: String) -> EmbedderEnvelope:
    return EmbedderEnvelope("openai", model_name, "", effect_envelope("std.rag.embed", "", "", "", "std.rag.embed"))

public agent ollama_embedder(model_name: String, endpoint: String) -> EmbedderEnvelope:
    return EmbedderEnvelope("ollama", model_name, endpoint, effect_envelope("std.rag.embed", "", "", "", "std.rag.embed"))

public agent chunk_is_grounded(chunk: RagChunkEnvelope) -> Bool:
    return chunk.provenance_key != ""

# ---------------------------------------------------------------
# Executing retrieval surface (slice 46g). The runtime dispatches
# these by exact name — the fifth executing surface after io /
# http / db+json / time+random. Index paths resolve through the
# SAME `[io] root` policy as file I/O (fails closed when
# unconfigured). Failures are Err values, not traps. With no
# `[rag]` embedder configured in corvid.toml, `rag_search`
# degrades HONESTLY to lexical search over the same index.

public effect rag_write:
    reversible: false
    data: external

# NOTE: rag_read deliberately does NOT carry `data: grounded` in
# v1 — the Grounded<T> wrapper at the import boundary depends on
# the cross-module provenance-composition slice (post-v1.0
# roadmap). Provenance is carried EXPLICITLY instead: every
# retrieved chunk's `provenance_key` + `effect_meta` travel in the
# envelope values.
public effect rag_read:
    reversible: true

# Chunk `text` (chunk_chars-sized windows with 20% overlap), store
# document + chunks in the SQLite index at `index_path`, and embed
# every chunk when an embedder is configured. Returns the chunk
# count.
public tool rag_ingest(index_path: String, doc_id: String, source: String, text: String, chunk_chars: Int) -> Result<Int, String> uses rag_write

# Retrieve the `limit` best chunks for `query` — cosine similarity
# over embeddings when configured, lexical match otherwise. Every
# retrieved chunk carries its provenance key.
public tool rag_search(index_path: String, query: String, limit: Int) -> Result<List<RagChunkEnvelope>, String> uses rag_read
