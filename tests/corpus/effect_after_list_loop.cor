# Every tier must preserve the trust requirement of the prompt after the loop.
effect early_effect:
    cost: $0.10

effect late_effect:
    trust: human_required

prompt early() -> String uses early_effect:
    "early"

prompt late() -> String uses late_effect:
    "late"

agent main() -> String:
    acc = ""
    for i in [1, 2, 3, 4, 5, 6, 7, 8]:
        acc = acc + early()
    return late()
