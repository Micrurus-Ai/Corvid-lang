# Adversarial: an `apply_account_credit` call without a prior
# `approve ApplyAccountCredit(...)` boundary must not compile.
# Slice 35V2-P42-D-LR-app-maturity-CustomerSupport-2.
# Expected: `corvid check` exits with E0101.

tool apply_account_credit(req: String) -> String dangerous

agent bad() -> String:
    return apply_account_credit("apply account credit without approval")
