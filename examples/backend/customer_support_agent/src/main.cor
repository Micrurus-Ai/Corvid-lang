tool send_support_reply(req: SupportReplySendRequest) -> SupportReplySendReceipt dangerous uses support_write
tool issue_support_refund(req: SupportRefundRequest) -> SupportRefundReceipt dangerous uses refund_write
tool escalate_ticket(req: EscalateTicketRequest) -> EscalateTicketReceipt dangerous uses escalate_write
tool close_ticket(req: CloseTicketRequest) -> CloseTicketReceipt dangerous uses ticket_write
tool apply_account_credit(req: ApplyAccountCreditRequest) -> ApplyAccountCreditReceipt dangerous uses credit_write

public @replayable
agent support_config() -> SupportConfig:
    return SupportConfig("customer_support_agent", "mock", true)

public @replayable
agent session_login(req: LoginRequest) -> LoginResponse:
    actor = user_actor(req.actor_id, req.tenant_id, req.display_name, "role:support_agent", "perm:support.read:support.operate", req.trace_id)
    sess = session_ref(req.session_id, actor.id, actor.tenant_id, 0, 4102444800000, 0, req.csrf_binding_id, req.trace_id)
    trace = auth_trace_for_session(actor, sess, "auth:session:" + req.session_id)
    decision = allow_permission(actor, trace, "support.tickets.read")
    return LoginResponse(actor, sess, trace, decision, "authenticated")

public @replayable
agent api_key_login(req: ApiKeyLoginRequest) -> ApiKeyLoginResponse:
    actor = service_actor(req.service_actor_id, req.tenant_id, req.display_name, "scope:support.jobs.run", req.trace_id)
    key = api_key_ref(req.api_key_id, actor.id, actor.tenant_id, "scope:support.jobs.run", "argon2id", 4102444800000, 0, req.trace_id)
    trace = auth_trace_for_api_key(actor, key, "auth:api_key:" + req.api_key_id)
    decision = allow_permission(actor, trace, "support.jobs.run")
    return ApiKeyLoginResponse(actor, key, trace, decision, "authenticated")

public @replayable
agent auth_status(actor_id: String, tenant_id: String, trace_id: String) -> AuthStatusResponse:
    actor = user_actor(actor_id, tenant_id, "Support Agent", "role:support_agent", "perm:support.read", trace_id)
    sess = session_ref("session-status", actor.id, actor.tenant_id, 0, 4102444800000, 0, "csrf-status", trace_id)
    trace = auth_trace_for_session(actor, sess, "auth:status:" + trace_id)
    active = session_active(sess, 1) and auth_trace_same_tenant(trace, actor)
    decision = allow_permission(actor, trace, "support.tickets.read")
    if active:
        return AuthStatusResponse(actor, actor.tenant_id, decision.allowed, decision.permission, decision.reason, trace.replay_key)
    denied = deny_permission(actor, trace, "support.tickets.read", "session inactive")
    return AuthStatusResponse(actor, actor.tenant_id, false, denied.permission, denied.reason, trace.replay_key)

public @replayable
agent api_key_auth_status(actor_id: String, tenant_id: String, trace_id: String) -> AuthStatusResponse:
    actor = service_actor(actor_id, tenant_id, "Support Service", "scope:support.jobs.run", trace_id)
    key = api_key_ref("api-key-status", actor.id, actor.tenant_id, "scope:support.jobs.run", "argon2id", 4102444800000, 0, trace_id)
    trace = auth_trace_for_api_key(actor, key, "auth:api_key_status:" + trace_id)
    active = api_key_active(key, 1) and auth_trace_same_tenant(trace, actor)
    decision = allow_permission(actor, trace, "support.jobs.run")
    if active:
        return AuthStatusResponse(actor, actor.tenant_id, decision.allowed, decision.permission, decision.reason, trace.replay_key)
    denied = deny_permission(actor, trace, "support.jobs.run", "api key inactive")
    return AuthStatusResponse(actor, actor.tenant_id, false, denied.permission, denied.reason, trace.replay_key)

public @replayable
agent support_contract(job_kind: String, tenant_window: String, approval_label: String, needs_review: Bool) -> SupportJobContract:
    idempotency = job_kind + ":" + tenant_window
    replay_value = "support:" + idempotency
    return SupportJobContract(job_kind, "customer_support_agent", job_kind + "Input", job_kind + "Output", 5, 0.50, approval_label, needs_review, idempotency, replay_value)

public @replayable
agent support_run(contract: SupportJobContract, input_fingerprint: String, output_fingerprint: String, plan_id: String, action_kind: String) -> SupportJobRun:
    state = pending_job_state(contract.idempotency_key, contract.queue_name, contract.job_kind, contract.max_attempts, contract.budget_usd, contract.needs_review, contract.idempotency_key, contract.replay_key)
    input = job_input(contract.job_kind, input_fingerprint, contract.input_schema)
    output = job_output(output_fingerprint, contract.output_schema)
    retry_plan = retry_policy(contract.max_attempts, "exponential_jitter", 1000, 600000, "customer_support_agent.dead_letter")
    effect_meta = effect_envelope("customer_support_agent." + contract.job_kind, "workspace:" + contract.queue_name, contract.approval_label, contract.idempotency_key, contract.replay_key)
    plan = plan_step(plan_id, "bounded support operations job step", "customer_support_agent")
    action = action_request(action_kind, contract.idempotency_key, contract.approval_label, contract.needs_review)
    review = review_verdict(true, "", "contract bounded by retry, budget, idempotency, and replay")
    return SupportJobRun(contract, state, input, output, retry_plan, effect_meta, plan, action, review)

public @replayable
agent sla_breach_scan_job(tenant_id: String, window: String) -> SupportJobRun uses ticket_read:
    contract = support_contract("sla_breach_scan", tenant_id + ":" + window, "", false)
    return support_run(contract, "sha256:sla_breach_scan_input", "sha256:sla_breach_scan_output", "sla_scan.plan", "flag_tickets_nearing_breach")

public @replayable
agent nightly_csat_rollup_job(tenant_id: String, day: String) -> SupportJobRun uses ticket_read:
    contract = support_contract("nightly_csat_rollup", tenant_id + ":" + day, "", false)
    return support_run(contract, "sha256:csat_rollup_input", "sha256:csat_rollup_output", "csat_rollup.plan", "aggregate_satisfaction")

public @replayable
agent policy_reindex_job(tenant_id: String, corpus: String) -> SupportJobRun uses policy_search:
    contract = support_contract("policy_reindex", tenant_id + ":" + corpus, "", false)
    return support_run(contract, "sha256:policy_reindex_input", "sha256:policy_reindex_output", "policy_reindex.plan", "refresh_policy_corpus")

public @replayable
agent support_job_contract_valid(run: SupportJobRun) -> Bool:
    return retry_policy_valid(run.retry_plan) and job_metadata_redacted(run.input, run.output) and replay_safe(run.effect_meta) and run.state.budget_usd <= run.contract.budget_usd and run.state.idempotency_key == run.contract.idempotency_key

public @replayable
agent support_schema_manifest() -> SupportSchemaManifest:
    return SupportSchemaManifest("customer_support_agent", 5, 20, 3, 3, 5, "mock", true)

public @replayable
agent demo_ticket() -> SupportTicket uses ticket_read:
    return SupportTicket("ticket-1", "tenant-1", "sha256:customer-demo", "sha256:subject-demo", "high", "open")

public @replayable
agent demo_policy_citation() -> PolicyCitation uses policy_search:
    return PolicyCitation("policy-refund-1", "sha256:refund-policy", "refund.window", "policy:refund:window")

public @replayable
agent triage_ticket_mock() -> SupportTriage uses ticket_read, policy_search, support_ai:
    ticket = demo_ticket()
    citation = demo_policy_citation()
    return SupportTriage(ticket, "refund_request", ticket.priority, 0.9, citation, citation.provenance_id != "")

public @replayable
agent draft_policy_grounded_reply_mock() -> SupportDraftReply uses ticket_read, policy_search, support_ai:
    triage = triage_ticket_mock()
    return SupportDraftReply(triage.ticket.id, "sha256:support-draft", triage.citation, "drafted", "SendSupportReply", triage.grounded)

public @replayable
agent support_triage_contract_valid(reply: SupportDraftReply) -> Bool:
    return reply.grounded and reply.citation.provenance_id != "" and reply.approval_label == "SendSupportReply" and reply.status == "drafted"

agent execute_approved_support_reply(req: SupportReplySendRequest) -> SupportReplySendReceipt uses support_write:
    approve SendSupportReply(req)
    return send_support_reply(req)

agent execute_approved_support_refund(req: SupportRefundRequest) -> SupportRefundReceipt uses refund_write:
    approve IssueSupportRefund(req)
    return issue_support_refund(req)

# Developer-authored approval flow. Each contract below is the
# developer's explicit choice — role, cost ceiling, data class,
# irreversibility, and expiry are declared in source. Customer-facing
# replies must be policy-grounded (the SupportDraftReply carries the
# citation); the approval contracts gate the act of sending or changing
# state. Corvid enforces the `approve <Label>` boundary; it never
# decides the flow.
public @replayable
agent send_support_reply_approval_contract(tenant_id: String, ticket_id: String, trace_id: String) -> ApprovalContractRef:
    return approval_contract_ref("send-reply:" + ticket_id, "v1", "SendSupportReply", "ticket", ticket_id, tenant_id, "Reviewer", 0.05, "customer", true, 4102444800000, "approval:send_reply:" + trace_id)

public @replayable
agent issue_support_refund_approval_contract(tenant_id: String, ticket_id: String, trace_id: String) -> ApprovalContractRef:
    return approval_contract_ref("issue-refund:" + ticket_id, "v1", "IssueSupportRefund", "ticket", ticket_id, tenant_id, "Admin", 0.25, "financial", true, 4102444800000, "approval:issue_refund:" + trace_id)

public @replayable
agent escalate_ticket_approval_contract(tenant_id: String, ticket_id: String, trace_id: String) -> ApprovalContractRef:
    return approval_contract_ref("escalate-ticket:" + ticket_id, "v1", "EscalateTicket", "ticket", ticket_id, tenant_id, "Reviewer", 0.05, "customer", false, 4102444800000, "approval:escalate_ticket:" + trace_id)

public @replayable
agent close_ticket_approval_contract(tenant_id: String, ticket_id: String, trace_id: String) -> ApprovalContractRef:
    return approval_contract_ref("close-ticket:" + ticket_id, "v1", "CloseTicket", "ticket", ticket_id, tenant_id, "Reviewer", 0.05, "customer", false, 4102444800000, "approval:close_ticket:" + trace_id)

public @replayable
agent apply_account_credit_approval_contract(tenant_id: String, customer_fingerprint: String, trace_id: String) -> ApprovalContractRef:
    return approval_contract_ref("apply-credit:" + customer_fingerprint, "v1", "ApplyAccountCredit", "customer", customer_fingerprint, tenant_id, "Admin", 0.25, "financial", true, 4102444800000, "approval:apply_credit:" + trace_id)

agent execute_approved_escalate_ticket(req: EscalateTicketRequest) -> EscalateTicketReceipt uses escalate_write:
    approve EscalateTicket(req)
    return escalate_ticket(req)

agent execute_approved_close_ticket(req: CloseTicketRequest) -> CloseTicketReceipt uses ticket_write:
    approve CloseTicket(req)
    return close_ticket(req)

agent execute_approved_apply_account_credit(req: ApplyAccountCreditRequest) -> ApplyAccountCreditReceipt uses credit_write:
    approve ApplyAccountCredit(req)
    return apply_account_credit(req)

public @replayable
agent approval_surface_valid(tenant_id: String, trace_id: String) -> Bool:
    a = send_support_reply_approval_contract(tenant_id, "ticket-1", trace_id)
    b = issue_support_refund_approval_contract(tenant_id, "ticket-1", trace_id)
    c = escalate_ticket_approval_contract(tenant_id, "ticket-1", trace_id)
    d = close_ticket_approval_contract(tenant_id, "ticket-1", trace_id)
    e = apply_account_credit_approval_contract(tenant_id, "sha256:customer-demo", trace_id)
    reply_ok = a.action == "SendSupportReply" and a.required_role == "Reviewer" and a.data_class == "customer" and a.irreversible
    refund_ok = b.action == "IssueSupportRefund" and b.required_role == "Admin" and b.data_class == "financial" and b.irreversible
    escalate_ok = c.action == "EscalateTicket" and c.required_role == "Reviewer" and c.data_class == "customer"
    close_ok = d.action == "CloseTicket" and d.required_role == "Reviewer" and d.data_class == "customer"
    credit_ok = e.action == "ApplyAccountCredit" and e.required_role == "Admin" and e.data_class == "financial" and e.irreversible
    return reply_ok and refund_ok and escalate_ok and close_ok and credit_ok

public @replayable
agent support_sla_job() -> SupportSlaJob:
    ticket = demo_ticket()
    return SupportSlaJob("sla-1", ticket.tenant_id, ticket.id, "2026-04-29T18:00:00Z", "scheduled", "support:sla:ticket-1")

public @replayable
agent support_eval_dashboard() -> SupportEvalDashboard:
    return SupportEvalDashboard(1, 5, 1, 4)

public @replayable
agent support_ops_contract_valid(dashboard: SupportEvalDashboard, sla: SupportSlaJob) -> Bool:
    return dashboard.grounded_replies >= 1 and dashboard.approval_gated_writes == 5 and dashboard.sla_jobs == 1 and sla.replay_key == "support:sla:ticket-1"

server customer_support_agent_api:
    route GET "/config" -> json SupportConfig:
        return support_config()
    route GET "/schema" -> json SupportSchemaManifest:
        return support_schema_manifest()
    route GET "/tickets/triage/mock" -> json SupportTriage uses ticket_read, policy_search, support_ai:
        return triage_ticket_mock()
    route GET "/replies/draft/mock" -> json SupportDraftReply uses ticket_read, policy_search, support_ai:
        return draft_policy_grounded_reply_mock()
    route GET "/sla/jobs/mock" -> json SupportSlaJob:
        return support_sla_job()
    route GET "/eval/dashboard/mock" -> json SupportEvalDashboard:
        return support_eval_dashboard()
    route POST "/replies/send" body SupportReplySendRequest -> json SupportReplySendReceipt uses support_write:
        return execute_approved_support_reply(body)
    route POST "/refunds/issue" body SupportRefundRequest -> json SupportRefundReceipt uses refund_write:
        return execute_approved_support_refund(body)
    route POST "/tickets/escalate" body EscalateTicketRequest -> json EscalateTicketReceipt uses escalate_write:
        return execute_approved_escalate_ticket(body)
    route POST "/tickets/close" body CloseTicketRequest -> json CloseTicketReceipt uses ticket_write:
        return execute_approved_close_ticket(body)
    route POST "/credits/apply" body ApplyAccountCreditRequest -> json ApplyAccountCreditReceipt uses credit_write:
        return execute_approved_apply_account_credit(body)
    route POST "/auth/session/login" body LoginRequest -> json LoginResponse:
        return session_login(body)
    route POST "/auth/api-key/login" body ApiKeyLoginRequest -> json ApiKeyLoginResponse:
        return api_key_login(body)
    route GET "/auth/status" -> json AuthStatusResponse:
        return auth_status("user-1", "tenant-1", "trace-auth-status")
    route GET "/auth/api-key/status" -> json AuthStatusResponse:
        return api_key_auth_status("service-1", "tenant-1", "trace-api-key-status")
    route GET "/jobs/sla-breach-scan/mock" -> json SupportJobRun uses ticket_read:
        return sla_breach_scan_job("tenant-1", "business_hour")
    route GET "/jobs/nightly-csat-rollup/mock" -> json SupportJobRun uses ticket_read:
        return nightly_csat_rollup_job("tenant-1", "2026-05-28")
    route GET "/jobs/policy-reindex/mock" -> json SupportJobRun uses policy_search:
        return policy_reindex_job("tenant-1", "support_policies")

schedule "0 * * * *" zone "America/New_York" -> sla_breach_scan_job("tenant-1", "business_hour") uses ticket_read
schedule "0 2 * * *" zone "America/New_York" -> nightly_csat_rollup_job("tenant-1", "business_day") uses ticket_read
schedule "0 3 * * *" zone "America/New_York" -> policy_reindex_job("tenant-1", "support_policies") uses policy_search

agent main() -> Bool:
    reply = draft_policy_grounded_reply_mock()
    dashboard = support_eval_dashboard()
    sla = support_sla_job()
    auth = auth_status("user-1", "tenant-1", "trace-main-auth")
    service_auth = api_key_auth_status("service-1", "tenant-1", "trace-main-api-key")
    sla_scan = sla_breach_scan_job("tenant-1", "business_hour")
    csat = nightly_csat_rollup_job("tenant-1", "business_day")
    reindex = policy_reindex_job("tenant-1", "support_policies")
    approvals_ok = approval_surface_valid("tenant-1", "trace-main-approvals")
    return support_triage_contract_valid(reply) and support_ops_contract_valid(dashboard, sla) and auth.authenticated and service_auth.authenticated and support_job_contract_valid(sla_scan) and support_job_contract_valid(csat) and support_job_contract_valid(reindex) and approvals_ok
