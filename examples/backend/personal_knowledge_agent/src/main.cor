agent execute_approved_share_answer_to_chat(req: ShareAnswerToChatRequest) -> ShareAnswerToChatReceipt uses chat_share:
    approve ShareAnswerToChat(req)
    return share_answer_to_chat(req)

agent execute_approved_share_answer_via_email(req: ShareAnswerViaEmailRequest) -> ShareAnswerViaEmailReceipt uses email_share:
    approve ShareAnswerViaEmail(req)
    return share_answer_via_email(req)

agent execute_approved_publish_authoritative_answer(req: PublishAuthoritativeAnswerRequest) -> PublishAuthoritativeAnswerReceipt uses kb_publish:
    approve PublishAuthoritativeAnswer(req)
    return publish_authoritative_answer(req)

agent execute_approved_export_tenant_corpus(req: ExportTenantCorpusRequest) -> ExportTenantCorpusReceipt uses corpus_export:
    approve ExportTenantCorpus(req)
    return export_tenant_corpus(req)

agent execute_approved_cross_tenant_index_share(req: CrossTenantIndexShareRequest) -> CrossTenantIndexShareReceipt uses cross_tenant_share:
    approve CrossTenantIndexShare(req)
    return cross_tenant_index_share(req)

public @replayable
agent approval_surface_valid(tenant_id: String, trace_id: String) -> Bool:
    a = share_answer_to_chat_approval_contract(tenant_id, "channel-1", trace_id)
    b = share_answer_via_email_approval_contract(tenant_id, "team@example.com", trace_id)
    c = publish_authoritative_answer_approval_contract(tenant_id, "kb-1", trace_id)
    d = export_tenant_corpus_approval_contract(tenant_id, "s3://backups/pka-export", trace_id)
    e = cross_tenant_index_share_approval_contract(tenant_id, "tenant-2", trace_id)
    chat_ok = a.action == "ShareAnswerToChat" and a.required_role == "Reviewer" and a.data_class == "external"
    email_ok = b.action == "ShareAnswerViaEmail" and b.required_role == "Reviewer" and b.data_class == "external"
    publish_ok = c.action == "PublishAuthoritativeAnswer" and c.required_role == "Reviewer" and c.data_class == "external"
    export_ok = d.action == "ExportTenantCorpus" and d.required_role == "Admin" and d.data_class == "external"
    cross_ok = e.action == "CrossTenantIndexShare" and e.required_role == "Admin" and e.data_class == "external"
    return chat_ok and email_ok and publish_ok and export_ok and cross_ok

# Typed permission per dangerous tool. The auth surface (sessions +
# API keys + per-tenant + per-role) propagates these through Actor
# permissions; the strings here are the canonical identifiers any auth
# check refers to. One distinct permission per dangerous tool closes the
# maturity-bar requirement of "≥1 typed permission per dangerous tool".
public @replayable
agent permission_for_share_answer_to_chat() -> String:
    return "knowledge.tool.share_answer_to_chat"

public @replayable
agent permission_for_share_answer_via_email() -> String:
    return "knowledge.tool.share_answer_via_email"

public @replayable
agent permission_for_publish_authoritative_answer() -> String:
    return "knowledge.tool.publish_authoritative_answer"

public @replayable
agent permission_for_export_tenant_corpus() -> String:
    return "knowledge.tool.export_tenant_corpus"

public @replayable
agent permission_for_cross_tenant_index_share() -> String:
    return "knowledge.tool.cross_tenant_index_share"

public @replayable
agent dangerous_tool_permissions_distinct() -> Bool:
    a = permission_for_share_answer_to_chat()
    b = permission_for_share_answer_via_email()
    c = permission_for_publish_authoritative_answer()
    d = permission_for_export_tenant_corpus()
    e = permission_for_cross_tenant_index_share()
    ab = a != b
    ac = a != c
    ad = a != d
    ae = a != e
    bc = b != c
    bd = b != d
    be = b != e
    cd = c != d
    ce = c != e
    de = d != e
    return ab and ac and ad and ae and bc and bd and be and cd and ce and de

public @replayable
agent knowledge_schema_manifest() -> KnowledgeSchemaManifest:
    return KnowledgeSchemaManifest("personal_knowledge_agent", 5, 18, 3, 3, 5, "mock")

identity knowledge_users:
    provider google
    provisioning:
        first_login: open
        tenant: fixed("personal-knowledge")
    roles:
        reviewer: "approvals.decide"

server personal_knowledge_agent_api:
    route GET "/config" -> json KnowledgeConfig:
        return knowledge_config()
    route GET "/schema" -> json KnowledgeSchemaManifest:
        return knowledge_schema_manifest()
    route GET "/ingest/mock" -> json KnowledgeIngestionResult uses files_read, local_embed, index_write:
        return ingest_mock_document()
    route GET "/search/mock" -> json KnowledgeSearchHit uses files_read, local_embed:
        return grounded_search_mock()
    route GET "/answer/mock" -> json KnowledgeAnswer uses files_read, local_embed:
        return answer_with_provenance_mock()
    route GET "/feedback/eval/mock" -> json KnowledgeFeedbackEval:
        return feedback_eval_mock()
    route POST "/auth/session/login" body LoginRequest -> json LoginResponse:
        return session_login(body)
    route POST "/auth/api-key/login" body ApiKeyLoginRequest -> json ApiKeyLoginResponse:
        return api_key_login(body)
    route GET "/auth/status" -> json AuthStatusResponse:
        return auth_status("user-1", "tenant-1", "trace-auth-status")
    route GET "/auth/api-key/status" -> json AuthStatusResponse:
        return api_key_auth_status("service-1", "tenant-1", "trace-api-key-status")
    route GET "/jobs/nightly-reindex/mock" -> json KnowledgeJobRun uses files_read, local_embed, index_write:
        return nightly_reindex_job("tenant-1", "notes")
    route GET "/jobs/weekly-feedback-batch/mock" -> json KnowledgeJobRun uses knowledge_llm:
        return weekly_feedback_batch_job("tenant-1", "business_week")
    route GET "/jobs/daily-provenance-audit/mock" -> json KnowledgeJobRun uses files_read:
        return daily_provenance_audit_job("tenant-1", "2026-05-27")
    @approval(role: "reviewer", risk: "external_share", data: "tenant_knowledge", expires_ms: 900000, max_cost_usd: $5.0, irreversible: true)
    route POST "/actions/share/chat" body ShareAnswerToChatRequest -> json ShareAnswerToChatReceipt uses chat_share requires authenticated:
        return execute_approved_share_answer_to_chat(body)
    @approval(role: "reviewer", risk: "external_share", data: "tenant_knowledge", expires_ms: 900000, max_cost_usd: $5.0, irreversible: true)
    route POST "/actions/share/email" body ShareAnswerViaEmailRequest -> json ShareAnswerViaEmailReceipt uses email_share requires authenticated:
        return execute_approved_share_answer_via_email(body)
    @approval(role: "reviewer", risk: "authoritative_publish", data: "tenant_knowledge", expires_ms: 900000, max_cost_usd: $10.0, irreversible: true)
    route POST "/actions/publish/authoritative" body PublishAuthoritativeAnswerRequest -> json PublishAuthoritativeAnswerReceipt uses kb_publish requires authenticated:
        return execute_approved_publish_authoritative_answer(body)
    @approval(role: "reviewer", risk: "bulk_export", data: "tenant_knowledge", expires_ms: 900000, max_cost_usd: $25.0, irreversible: true)
    route POST "/actions/export/corpus" body ExportTenantCorpusRequest -> json ExportTenantCorpusReceipt uses corpus_export requires authenticated:
        return execute_approved_export_tenant_corpus(body)
    @approval(role: "reviewer", risk: "cross_tenant_share", data: "tenant_knowledge", expires_ms: 900000, max_cost_usd: $25.0, irreversible: true)
    route POST "/actions/share/cross-tenant" body CrossTenantIndexShareRequest -> json CrossTenantIndexShareReceipt uses cross_tenant_share requires authenticated:
        return execute_approved_cross_tenant_index_share(body)

schedule "0 2 * * *" zone "America/New_York" -> nightly_reindex_job("tenant-1", "notes") uses files_read, local_embed, index_write
schedule "0 6 * * 1" zone "America/New_York" -> weekly_feedback_batch_job("tenant-1", "business_week") uses knowledge_llm
schedule "0 3 * * *" zone "America/New_York" -> daily_provenance_audit_job("tenant-1", "business_day") uses files_read

# Directly-embeddable C-ABI entrypoint. A host loads the cdylib and
# calls `ask` for a provenance-keyed answer; the richer struct-typed
# agents (auth / jobs / approvals + the KnowledgeAnswer surface) stay
# reachable through the always-exported catalog ABI (corvid_call_agent),
# so one scalar export unlocks the whole typed surface to a host.
@budget($1.00)
pub extern "c"
agent ask(question: String) -> String:
    answer = answer_with_provenance_mock()
    return "knowledge:answer:" + question + ":" + answer.answer_fingerprint

agent main() -> Bool:
    result = ingest_mock_document()
    answer = answer_with_provenance_mock()
    feedback = feedback_eval_mock()
    auth = auth_status("user-1", "tenant-1", "trace-main-auth")
    service_auth = api_key_auth_status("service-1", "tenant-1", "trace-main-api-key")
    reindex = nightly_reindex_job("tenant-1", "notes")
    fb_batch = weekly_feedback_batch_job("tenant-1", "business_week")
    audit = daily_provenance_audit_job("tenant-1", "business_day")
    approvals_ok = approval_surface_valid("tenant-1", "trace-main-approvals")
    permissions_ok = dangerous_tool_permissions_distinct()
    return ingestion_contract_valid(result) and answer_contract_valid(answer) and feedback_eval_contract_valid(feedback) and auth.authenticated and service_auth.authenticated and knowledge_job_contract_valid(reindex) and knowledge_job_contract_valid(fb_batch) and knowledge_job_contract_valid(audit) and approvals_ok and permissions_ok
