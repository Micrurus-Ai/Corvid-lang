agent share_answer_via_email_approval_contract(tenant_id: String, recipient: String, trace_id: String) -> ApprovalContractRef:
    return approval_contract_ref("share-email:" + recipient, "v1", "ShareAnswerViaEmail", "email_recipient", recipient, tenant_id, "Reviewer", 0.05, "external", true, 4102444800000, "approval:share_email:" + trace_id)

