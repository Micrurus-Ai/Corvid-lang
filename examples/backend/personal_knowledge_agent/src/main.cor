import "../../../../std/jobs" use JobInputEnvelope, JobOutputEnvelope, JobRetryPolicy, JobStateEnvelope, job_input, job_output, retry_policy, retry_policy_valid, pending_job_state, job_needs_approval, job_metadata_redacted
import "../../../../std/effects" use EffectEnvelope, effect_envelope, replay_safe, approval_required
import "../../../../std/agent" use PlanStep, ActionRequest, ReviewVerdict, plan_step, action_request, review_verdict
import "../../../../std/auth" use Actor, SessionRef, ApiKeyRef, AuthTraceContext, AuthDecision, user_actor, service_actor, session_ref, api_key_ref, auth_trace_for_session, auth_trace_for_api_key, allow_permission, deny_permission, session_active, api_key_active, auth_trace_same_tenant
import "../../../../std/approvals" use ApprovalContractRef, ApprovalQueueItem, ApprovalAuditEnvelope, approval_contract_ref, approval_queue_item, approval_audit_envelope, approval_pending, approval_same_tenant, approval_not_expired, approval_redacted

effect files_read:
    cost: $0.01
    trust: local
    data: private

effect local_embed:
    cost: $0.02
    trust: local
    data: private

effect index_write:
    cost: $0.01
    trust: local
    data: private

effect knowledge_llm:
    cost: $0.20
    trust: bounded
    data: private

effect chat_share:
    cost: $0.01
    trust: human_required
    data: external

effect email_share:
    cost: $0.02
    trust: human_required
    data: external

effect kb_publish:
    cost: $0.02
    trust: human_required
    data: external

effect corpus_export:
    cost: $0.05
    trust: human_required
    data: external

effect cross_tenant_share:
    cost: $0.03
    trust: human_required
    data: external

public type KnowledgeConfig:
    service: String
    connector_mode: String
    storage_mode: String
    local_only: Bool
    trace_dir: String

public type KnowledgeSource:
    id: String
    tenant_id: String
    root_id: String
    path: String
    media_type: String
    content_hash: String
    provenance_id: String

public type KnowledgeDocument:
    id: String
    tenant_id: String
    source_id: String
    title_fingerprint: String
    content_hash: String
    version: Int
    provenance_id: String

public type KnowledgeChunk:
    id: String
    tenant_id: String
    document_id: String
    source_id: String
    byte_start: Int
    byte_end: Int
    text_fingerprint: String
    provenance_id: String

public type KnowledgeEmbedding:
    id: String
    chunk_id: String
    provider: String
    model_name: String
    vector_hash: String
    local_only: Bool

public type KnowledgeIngestionJob:
    id: String
    tenant_id: String
    root_id: String
    status: String
    discovered_count: Int
    indexed_count: Int
    replay_key: String

public type KnowledgeIngestionResult:
    source: KnowledgeSource
    document: KnowledgeDocument
    chunk: KnowledgeChunk
    embedding: KnowledgeEmbedding
    job: KnowledgeIngestionJob
    provenance_preserved: Bool
    private_local_mode: Bool

public type KnowledgeSearchRequest:
    tenant_id: String
    query_fingerprint: String
    top_k: Int
    local_only: Bool

public type KnowledgeCitation:
    document_id: String
    chunk_id: String
    source_path: String
    byte_start: Int
    byte_end: Int
    provenance_id: String

public type KnowledgeSearchHit:
    chunk: KnowledgeChunk
    citation: KnowledgeCitation
    score: Float
    grounded: Bool

public type KnowledgeAnswer:
    tenant_id: String
    question_fingerprint: String
    answer_fingerprint: String
    hit: KnowledgeSearchHit
    citation_count: Int
    grounded: Bool
    provenance_id: String
    trace_id: String

public type KnowledgeFeedbackEval:
    id: String
    tenant_id: String
    answer_fingerprint: String
    accepted: Bool
    citation_count: Int
    promoted_to_eval: Bool
    trace_id: String

public type LoginRequest:
    tenant_id: String
    actor_id: String
    display_name: String
    session_id: String
    csrf_binding_id: String
    trace_id: String

public type ApiKeyLoginRequest:
    tenant_id: String
    service_actor_id: String
    display_name: String
    api_key_id: String
    trace_id: String

public type LoginResponse:
    actor: Actor
    session_ref: SessionRef
    trace: AuthTraceContext
    decision: AuthDecision
    status: String

public type ApiKeyLoginResponse:
    actor: Actor
    api_key: ApiKeyRef
    trace: AuthTraceContext
    decision: AuthDecision
    status: String

public type AuthStatusResponse:
    actor: Actor
    tenant_id: String
    authenticated: Bool
    permission: String
    reason: String
    replay_key: String

public type KnowledgeJobContract:
    job_kind: String
    queue_name: String
    input_schema: String
    output_schema: String
    max_attempts: Int
    budget_usd: Float
    approval_label: String
    needs_review: Bool
    idempotency_key: String
    replay_key: String

public type KnowledgeJobRun:
    contract: KnowledgeJobContract
    state: JobStateEnvelope
    input: JobInputEnvelope
    output: JobOutputEnvelope
    retry_plan: JobRetryPolicy
    effect_meta: EffectEnvelope
    plan: PlanStep
    action: ActionRequest
    review: ReviewVerdict

public type KnowledgeSchemaManifest:
    service: String
    migration_count: Int
    table_count: Int
    connector_count: Int
    job_count: Int
    approval_count: Int
    default_mode: String

