agent share_answer_to_chat_approval_contract(tenant_id: String, channel_id: String, trace_id: String) -> ApprovalContractRef:
    return approval_contract_ref("share-chat:" + channel_id, "v1", "ShareAnswerToChat", "chat_channel", channel_id, tenant_id, "Reviewer", 0.05, "external", true, 4102444800000, "approval:share_chat:" + trace_id)

