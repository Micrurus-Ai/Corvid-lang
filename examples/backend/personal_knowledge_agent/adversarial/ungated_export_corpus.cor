# Adversarial: an `export_tenant_corpus` call without a prior
# `approve ExportTenantCorpus(...)` boundary must not compile.
# Slice 35V2-P42-D-LR-app-maturity-PKA-2.
# Expected: `corvid check` exits with E0101.

tool export_tenant_corpus(req: String) -> String dangerous

agent bad() -> String:
    return export_tenant_corpus("export without approval")
