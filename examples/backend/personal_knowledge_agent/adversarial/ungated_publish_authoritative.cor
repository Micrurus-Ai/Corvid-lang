# Adversarial: a `publish_authoritative_answer` call without a prior
# `approve PublishAuthoritativeAnswer(...)` boundary must not compile.
# Slice 35V2-P42-D-LR-app-maturity-PKA-2.
# Expected: `corvid check` exits with E0101.

tool publish_authoritative_answer(req: String) -> String dangerous

agent bad() -> String:
    return publish_authoritative_answer("publish without approval")
