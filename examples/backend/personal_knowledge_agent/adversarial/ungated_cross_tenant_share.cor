# Adversarial: a `cross_tenant_index_share` call without a prior
# `approve CrossTenantIndexShare(...)` boundary must not compile.
# Slice 35V2-P42-D-LR-app-maturity-PKA-2.
# Expected: `corvid check` exits with E0101.

tool cross_tenant_index_share(req: String) -> String dangerous

agent bad() -> String:
    return cross_tenant_index_share("cross-tenant share without approval")
