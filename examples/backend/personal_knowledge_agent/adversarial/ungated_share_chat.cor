# Adversarial: a `share_answer_to_chat` call without a prior
# `approve ShareAnswerToChat(...)` boundary must not compile.
# Slice 35V2-P42-D-LR-app-maturity-PKA-2.
# Expected: `corvid check` exits with E0101.

tool share_answer_to_chat(req: String) -> String dangerous

agent bad() -> String:
    return share_answer_to_chat("share without approval")
