# Code Maintenance Agent — hardening eval suite.
#
# Encodes the per-app maturity bar as typed structural invariants the
# eval interpreter can verify deterministically. Each case returns the
# expected shape; each `assert` fails loudly if the shape drifts.
# Self-contained — does not import `src/main.cor`, so the suite runs
# while the source's invariants evolve independently.
#
# The flow the contracts encode is the developer's choice: roles and
# reversibility differ per surface on purpose. The eval asserts the
# choices the developer made, not a one-size rule.
#
# Three fixture files under `evals/promoted/` are the trace-derived
# regression set produced by `corvid eval promote`.

type CodeMaturityBar:
    min_migrations: Int
    min_tables: Int
    min_connectors: Int
    min_jobs: Int
    min_approvals: Int
    min_adversarial_threats: Int
    min_cron_jobs: Int
    max_job_budget_usd: Float

type CodeManifestShape:
    migration_count: Int
    table_count: Int
    connector_count: Int
    job_count: Int
    approval_count: Int
    default_mode: String
    writes_require_approval: Bool

type ApprovalContractShape:
    label: String
    required_role: String
    cost_ceiling_usd: Float
    irreversible: Bool
    expires_in_hours: Int
    data_class: String

type CronSchedule:
    cron_expr: String
    time_zone: String
    job_name: String

type JobContractShape:
    job_kind: String
    queue_name: String
    max_attempts: Int
    budget_usd: Float
    has_replay_key: Bool

type CiTriageShape:
    ci_failed: Bool
    severity_high: Bool
    confidence_floor_met: Bool
    risk_label_grounded_in_ci: Bool

agent expected_maturity_bar() -> CodeMaturityBar:
    return CodeMaturityBar(5, 10, 3, 3, 5, 5, 3, 0.50)

agent expected_manifest() -> CodeManifestShape:
    return CodeManifestShape(5, 21, 3, 3, 5, "mock", true)

agent post_review_comment_approval() -> ApprovalContractShape:
    return ApprovalContractShape("PostReviewComment", "Reviewer", 0.05, false, 24, "code")

agent create_patch_proposal_approval() -> ApprovalContractShape:
    return ApprovalContractShape("CreatePatchProposal", "Reviewer", 0.05, false, 24, "code")

agent open_pull_request_approval() -> ApprovalContractShape:
    return ApprovalContractShape("OpenPullRequest", "Reviewer", 0.05, false, 24, "code")

agent merge_pull_request_approval() -> ApprovalContractShape:
    return ApprovalContractShape("MergePullRequest", "Admin", 0.25, true, 24, "code")

agent tag_release_approval() -> ApprovalContractShape:
    return ApprovalContractShape("TagRelease", "Admin", 0.25, true, 24, "code")

agent ci_signal_scan_schedule() -> CronSchedule:
    return CronSchedule("0 * * * *", "America/New_York", "hourly_ci_signal_scan_job")

agent repo_reindex_schedule() -> CronSchedule:
    return CronSchedule("0 2 * * *", "America/New_York", "nightly_repo_reindex_job")

agent stale_issue_sweep_schedule() -> CronSchedule:
    return CronSchedule("0 6 * * 1", "America/New_York", "weekly_stale_issue_sweep_job")

agent ci_signal_scan_job_contract() -> JobContractShape:
    return JobContractShape("hourly_ci_signal_scan", "code_maintenance_agent", 5, 0.50, true)

agent repo_reindex_job_contract() -> JobContractShape:
    return JobContractShape("nightly_repo_reindex", "code_maintenance_agent", 5, 0.50, true)

agent stale_issue_sweep_job_contract() -> JobContractShape:
    return JobContractShape("weekly_stale_issue_sweep", "code_maintenance_agent", 5, 0.50, true)

agent expected_ci_triage() -> CiTriageShape:
    return CiTriageShape(true, true, true, true)

# Case 1: schema manifest matches the per-app maturity bar minima.
agent case_schema_manifest_meets_maturity_bar() -> Bool:
    manifest = expected_manifest()
    bar = expected_maturity_bar()
    migrations_ok = manifest.migration_count >= bar.min_migrations
    tables_ok = manifest.table_count >= bar.min_tables
    connectors_ok = manifest.connector_count >= bar.min_connectors
    jobs_ok = manifest.job_count >= bar.min_jobs
    approvals_ok = manifest.approval_count >= bar.min_approvals
    mode_ok = manifest.default_mode == "mock"
    return migrations_ok and tables_ok and connectors_ok and jobs_ok and approvals_ok and mode_ok

# Case 2: five distinct approval contracts present, matching the
# operational write surfaces (comment, patch, PR open, merge, release).
agent case_five_distinct_approval_contracts() -> Bool:
    a = post_review_comment_approval()
    b = create_patch_proposal_approval()
    c = open_pull_request_approval()
    d = merge_pull_request_approval()
    e = tag_release_approval()
    labels_match = a.label == "PostReviewComment" and b.label == "CreatePatchProposal" and c.label == "OpenPullRequest" and d.label == "MergePullRequest" and e.label == "TagRelease"
    distinct_ab = a.label != b.label
    distinct_bc = b.label != c.label
    distinct_cd = c.label != d.label
    distinct_de = d.label != e.label
    return labels_match and distinct_ab and distinct_bc and distinct_cd and distinct_de

# Case 3: the mainline-changing and published surfaces are
# irreversible; the reversible proposals (comment, patch, PR) are not.
# Merging to mainline and publishing a release tag cannot be cleanly
# undone; a comment can be deleted, a patch is a proposal, a PR can be
# closed.
agent case_irreversibility_matches_developer_intent() -> Bool:
    a = post_review_comment_approval()
    b = create_patch_proposal_approval()
    c = open_pull_request_approval()
    d = merge_pull_request_approval()
    e = tag_release_approval()
    mainline_irreversible = d.irreversible and e.irreversible
    reversible_proposals = not a.irreversible and not b.irreversible and not c.irreversible
    a_expires = a.expires_in_hours <= 24
    b_expires = b.expires_in_hours <= 24
    c_expires = c.expires_in_hours <= 24
    d_expires = d.expires_in_hours <= 24
    e_expires = e.expires_in_hours <= 24
    return mainline_irreversible and reversible_proposals and a_expires and b_expires and c_expires and d_expires and e_expires

# Case 4: approval cost ceilings are non-zero and bounded.
agent case_approval_cost_ceilings_bounded() -> Bool:
    a = post_review_comment_approval()
    b = create_patch_proposal_approval()
    c = open_pull_request_approval()
    d = merge_pull_request_approval()
    e = tag_release_approval()
    a_ok = a.cost_ceiling_usd > 0.0 and a.cost_ceiling_usd <= 1.00
    b_ok = b.cost_ceiling_usd > 0.0 and b.cost_ceiling_usd <= 1.00
    c_ok = c.cost_ceiling_usd > 0.0 and c.cost_ceiling_usd <= 1.00
    d_ok = d.cost_ceiling_usd > 0.0 and d.cost_ceiling_usd <= 1.00
    e_ok = e.cost_ceiling_usd > 0.0 and e.cost_ceiling_usd <= 1.00
    return a_ok and b_ok and c_ok and d_ok and e_ok

# Case 5: the mainline-changing surfaces require Admin; the reversible
# proposal surfaces require Reviewer. This is the developer-defined
# role gradient.
agent case_role_gradient_matches_blast_radius() -> Bool:
    a = post_review_comment_approval()
    b = create_patch_proposal_approval()
    c = open_pull_request_approval()
    d = merge_pull_request_approval()
    e = tag_release_approval()
    admin_ops = d.required_role == "Admin" and e.required_role == "Admin"
    reviewer_ops = a.required_role == "Reviewer" and b.required_role == "Reviewer" and c.required_role == "Reviewer"
    return admin_ops and reviewer_ops

# Case 6: all three scheduled jobs in America/New_York with the
# expected cron expressions. CI scanning runs hourly because CI signals
# are time-sensitive; repo reindex runs overnight, stale-issue sweep
# weekly.
agent case_all_scheduled_jobs_in_configured_timezone() -> Bool:
    ci = ci_signal_scan_schedule()
    repo = repo_reindex_schedule()
    stale = stale_issue_sweep_schedule()
    zones_ny = ci.time_zone == "America/New_York" and repo.time_zone == "America/New_York" and stale.time_zone == "America/New_York"
    ci_cron = ci.cron_expr == "0 * * * *"
    repo_cron = repo.cron_expr == "0 2 * * *"
    stale_cron = stale.cron_expr == "0 6 * * 1"
    return zones_ny and ci_cron and repo_cron and stale_cron

# Case 7: every job contract bounded at $0.50 / 5 attempts /
# canonical queue name.
agent case_every_job_contract_bounded() -> Bool:
    bar = expected_maturity_bar()
    ci = ci_signal_scan_job_contract()
    repo = repo_reindex_job_contract()
    stale = stale_issue_sweep_job_contract()
    budgets_ok = ci.budget_usd <= bar.max_job_budget_usd and repo.budget_usd <= bar.max_job_budget_usd and stale.budget_usd <= bar.max_job_budget_usd
    attempts_ok = ci.max_attempts == 5 and repo.max_attempts == 5 and stale.max_attempts == 5
    queues_ok = ci.queue_name == "code_maintenance_agent" and repo.queue_name == "code_maintenance_agent" and stale.queue_name == "code_maintenance_agent"
    return budgets_ok and attempts_ok and queues_ok

# Case 8: every job has a stable replay key.
agent case_every_job_has_replay_key() -> Bool:
    ci = ci_signal_scan_job_contract()
    repo = repo_reindex_job_contract()
    stale = stale_issue_sweep_job_contract()
    return ci.has_replay_key and repo.has_replay_key and stale.has_replay_key

# Case 9: connector default mode is mock. The adversarial fixture
# `adversarial/raw_patch_committed.json` enforces the no-raw-code rule;
# this eval keeps mock-default in the regression surface.
agent case_connector_default_mode_is_mock() -> Bool:
    manifest = expected_manifest()
    return manifest.default_mode == "mock"

# Case 10: approval contract count meets the maturity bar AND every
# label is unique (catches duplicate-label drift across the 5
# operational surfaces).
agent case_approval_label_uniqueness() -> Bool:
    bar = expected_maturity_bar()
    manifest = expected_manifest()
    a = post_review_comment_approval()
    b = create_patch_proposal_approval()
    c = open_pull_request_approval()
    d = merge_pull_request_approval()
    e = tag_release_approval()
    ab = a.label != b.label
    ac = a.label != c.label
    ad = a.label != d.label
    ae = a.label != e.label
    bc = b.label != c.label
    bd = b.label != d.label
    be = b.label != e.label
    cd = c.label != d.label
    ce = c.label != e.label
    de = d.label != e.label
    distinct_pairs = ab and ac and ad and ae and bc and bd and be and cd and ce and de
    count_ok = manifest.approval_count >= bar.min_approvals
    return count_ok and distinct_pairs

# Case 11: CodeMaintenance-specific — the risk triage is CI-grounded.
# A high-severity regression label must be grounded in a failed CI
# signal at or above the confidence floor. This is the invariant that
# keeps risk labels evidence-based rather than guesses.
agent case_triage_is_ci_grounded() -> Bool:
    triage = expected_ci_triage()
    return triage.ci_failed and triage.severity_high and triage.confidence_floor_met and triage.risk_label_grounded_in_ci

eval code_maintenance_agent_per_app_maturity:
    assert case_schema_manifest_meets_maturity_bar()
    assert case_five_distinct_approval_contracts()
    assert case_irreversibility_matches_developer_intent()
    assert case_approval_cost_ceilings_bounded()
    assert case_role_gradient_matches_blast_radius()
    assert case_all_scheduled_jobs_in_configured_timezone()
    assert case_every_job_contract_bounded()
    assert case_every_job_has_replay_key()
    assert case_connector_default_mode_is_mock()
    assert case_approval_label_uniqueness()
    assert case_triage_is_ci_grounded()
