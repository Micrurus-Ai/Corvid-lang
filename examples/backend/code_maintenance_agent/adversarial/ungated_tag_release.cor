# Adversarial: a `tag_release` call without a prior
# `approve TagRelease(...)` boundary must not compile.
# Slice 35V2-P42-D-LR-app-maturity-CodeMaintenance-2.
# Expected: `corvid check` exits with E0101.

tool tag_release(req: String) -> String dangerous

agent bad() -> String:
    return tag_release("tag release without approval")
