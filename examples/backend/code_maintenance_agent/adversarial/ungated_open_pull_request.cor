# Adversarial: an `open_pull_request` call without a prior
# `approve OpenPullRequest(...)` boundary must not compile.
# Slice 35V2-P42-D-LR-app-maturity-CodeMaintenance-2.
# Expected: `corvid check` exits with E0101.

tool open_pull_request(req: String) -> String dangerous

agent bad() -> String:
    return open_pull_request("open pull request without approval")
