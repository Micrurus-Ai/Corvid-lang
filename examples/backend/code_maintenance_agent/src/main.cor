import "../../../../std/jobs" use JobInputEnvelope, JobOutputEnvelope, JobRetryPolicy, JobStateEnvelope, job_input, job_output, retry_policy, retry_policy_valid, pending_job_state, job_needs_approval, job_metadata_redacted
import "../../../../std/effects" use EffectEnvelope, effect_envelope, replay_safe, approval_required
import "../../../../std/agent" use PlanStep, ActionRequest, ReviewVerdict, plan_step, action_request, review_verdict
import "../../../../std/auth" use Actor, SessionRef, ApiKeyRef, AuthTraceContext, AuthDecision, user_actor, service_actor, session_ref, api_key_ref, auth_trace_for_session, auth_trace_for_api_key, allow_permission, deny_permission, session_active, api_key_active, auth_trace_same_tenant
import "../../../../std/approvals" use ApprovalContractRef, ApprovalQueueItem, ApprovalAuditEnvelope, approval_contract_ref, approval_queue_item, approval_audit_envelope, approval_pending, approval_same_tenant, approval_not_expired, approval_redacted

effect repo_read:
    cost: $0.01
    trust: workspace
    data: code

effect ci_read:
    cost: $0.01
    trust: workspace
    data: code

effect code_ai:
    cost: $0.08
    trust: bounded
    data: code

effect code_write:
    cost: $0.02
    trust: human_required
    data: code

effect pr_write:
    cost: $0.02
    trust: human_required
    data: code

effect merge_write:
    cost: $0.03
    trust: human_required
    data: code

effect release_write:
    cost: $0.03
    trust: human_required
    data: code

public type CodeConfig:
    service: String
    connector_mode: String
    writes_require_approval: Bool

public type LoginRequest:
    tenant_id: String
    actor_id: String
    display_name: String
    session_id: String
    csrf_binding_id: String
    trace_id: String

public type ApiKeyLoginRequest:
    tenant_id: String
    service_actor_id: String
    display_name: String
    api_key_id: String
    trace_id: String

public type LoginResponse:
    actor: Actor
    session_ref: SessionRef
    trace: AuthTraceContext
    decision: AuthDecision
    status: String

public type ApiKeyLoginResponse:
    actor: Actor
    api_key: ApiKeyRef
    trace: AuthTraceContext
    decision: AuthDecision
    status: String

public type AuthStatusResponse:
    actor: Actor
    tenant_id: String
    authenticated: Bool
    permission: String
    reason: String
    replay_key: String

public type CodeJobContract:
    job_kind: String
    queue_name: String
    input_schema: String
    output_schema: String
    max_attempts: Int
    budget_usd: Float
    approval_label: String
    needs_review: Bool
    idempotency_key: String
    replay_key: String

public type CodeJobRun:
    contract: CodeJobContract
    state: JobStateEnvelope
    input: JobInputEnvelope
    output: JobOutputEnvelope
    retry_plan: JobRetryPolicy
    effect_meta: EffectEnvelope
    plan: PlanStep
    action: ActionRequest
    review: ReviewVerdict

public type CodeSchemaManifest:
    service: String
    migration_count: Int
    table_count: Int
    connector_count: Int
    job_count: Int
    approval_count: Int
    default_mode: String
    writes_require_approval: Bool

public type RepoSnapshot:
    id: String
    tenant_id: String
    provider: String
    repo: String
    commit_sha: String
    tree_hash: String

public type IssueSnapshot:
    id: String
    tenant_id: String
    repo_id: String
    title_fingerprint: String
    body_fingerprint: String
    status: String

public type CiSignal:
    id: String
    repo_id: String
    commit_sha: String
    status: String
    failing_job: String
    log_fingerprint: String

public type CodeRiskLabel:
    issue: IssueSnapshot
    ci: CiSignal
    category: String
    severity: String
    confidence: Float
    replay_key: String

public type ReviewCommentRequest:
    tenant_id: String
    actor_id: String
    issue_id: String
    body_fingerprint: String
    approval_id: String
    trace_id: String

public type ReviewCommentReceipt:
    issue_id: String
    approval_id: String
    trace_id: String
    status: String

public type PatchProposalRequest:
    tenant_id: String
    actor_id: String
    repo_id: String
    patch_fingerprint: String
    approval_id: String
    trace_id: String

public type PatchProposalReceipt:
    repo_id: String
    approval_id: String
    trace_id: String
    status: String

public type CodeWritePlan:
    risk: CodeRiskLabel
    review_comment_fingerprint: String
    patch_fingerprint: String
    approval_count: Int
    writes_gated: Bool

public type OpenPullRequestRequest:
    tenant_id: String
    actor_id: String
    repo_id: String
    branch_fingerprint: String
    patch_fingerprint: String
    approval_id: String
    trace_id: String

public type OpenPullRequestReceipt:
    pull_request_id: String
    tenant_id: String
    repo_id: String
    approval_id: String
    trace_id: String
    status: String

public type MergePullRequestRequest:
    tenant_id: String
    actor_id: String
    repo_id: String
    pull_request_id: String
    merge_strategy: String
    approval_id: String
    trace_id: String

public type MergePullRequestReceipt:
    merge_id: String
    tenant_id: String
    repo_id: String
    pull_request_id: String
    merge_commit_sha: String
    approval_id: String
    trace_id: String
    status: String

public type TagReleaseRequest:
    tenant_id: String
    actor_id: String
    repo_id: String
    tag_fingerprint: String
    commit_sha: String
    approval_id: String
    trace_id: String

public type TagReleaseReceipt:
    release_id: String
    tenant_id: String
    repo_id: String
    tag_fingerprint: String
    commit_sha: String
    approval_id: String
    trace_id: String
    status: String

tool post_review_comment(req: ReviewCommentRequest) -> ReviewCommentReceipt dangerous uses code_write
tool create_patch_proposal(req: PatchProposalRequest) -> PatchProposalReceipt dangerous uses code_write
tool open_pull_request(req: OpenPullRequestRequest) -> OpenPullRequestReceipt dangerous uses pr_write
tool merge_pull_request(req: MergePullRequestRequest) -> MergePullRequestReceipt dangerous uses merge_write
tool tag_release(req: TagReleaseRequest) -> TagReleaseReceipt dangerous uses release_write

public @replayable
agent code_config() -> CodeConfig:
    return CodeConfig("code_maintenance_agent", "mock", true)

public @replayable
agent session_login(req: LoginRequest) -> LoginResponse:
    actor = user_actor(req.actor_id, req.tenant_id, req.display_name, "role:code_maintainer", "perm:code.read:code.operate", req.trace_id)
    sess = session_ref(req.session_id, actor.id, actor.tenant_id, 0, 4102444800000, 0, req.csrf_binding_id, req.trace_id)
    trace = auth_trace_for_session(actor, sess, "auth:session:" + req.session_id)
    decision = allow_permission(actor, trace, "code.repos.read")
    return LoginResponse(actor, sess, trace, decision, "authenticated")

public @replayable
agent api_key_login(req: ApiKeyLoginRequest) -> ApiKeyLoginResponse:
    actor = service_actor(req.service_actor_id, req.tenant_id, req.display_name, "scope:code.jobs.run", req.trace_id)
    key = api_key_ref(req.api_key_id, actor.id, actor.tenant_id, "scope:code.jobs.run", "argon2id", 4102444800000, 0, req.trace_id)
    trace = auth_trace_for_api_key(actor, key, "auth:api_key:" + req.api_key_id)
    decision = allow_permission(actor, trace, "code.jobs.run")
    return ApiKeyLoginResponse(actor, key, trace, decision, "authenticated")

public @replayable
agent auth_status(actor_id: String, tenant_id: String, trace_id: String) -> AuthStatusResponse:
    actor = user_actor(actor_id, tenant_id, "Code Maintainer", "role:code_maintainer", "perm:code.read", trace_id)
    sess = session_ref("session-status", actor.id, actor.tenant_id, 0, 4102444800000, 0, "csrf-status", trace_id)
    trace = auth_trace_for_session(actor, sess, "auth:status:" + trace_id)
    active = session_active(sess, 1) and auth_trace_same_tenant(trace, actor)
    decision = allow_permission(actor, trace, "code.repos.read")
    if active:
        return AuthStatusResponse(actor, actor.tenant_id, decision.allowed, decision.permission, decision.reason, trace.replay_key)
    denied = deny_permission(actor, trace, "code.repos.read", "session inactive")
    return AuthStatusResponse(actor, actor.tenant_id, false, denied.permission, denied.reason, trace.replay_key)

public @replayable
agent api_key_auth_status(actor_id: String, tenant_id: String, trace_id: String) -> AuthStatusResponse:
    actor = service_actor(actor_id, tenant_id, "Code Service", "scope:code.jobs.run", trace_id)
    key = api_key_ref("api-key-status", actor.id, actor.tenant_id, "scope:code.jobs.run", "argon2id", 4102444800000, 0, trace_id)
    trace = auth_trace_for_api_key(actor, key, "auth:api_key_status:" + trace_id)
    active = api_key_active(key, 1) and auth_trace_same_tenant(trace, actor)
    decision = allow_permission(actor, trace, "code.jobs.run")
    if active:
        return AuthStatusResponse(actor, actor.tenant_id, decision.allowed, decision.permission, decision.reason, trace.replay_key)
    denied = deny_permission(actor, trace, "code.jobs.run", "api key inactive")
    return AuthStatusResponse(actor, actor.tenant_id, false, denied.permission, denied.reason, trace.replay_key)

public @replayable
agent code_contract(job_kind: String, tenant_window: String, approval_label: String, needs_review: Bool) -> CodeJobContract:
    idempotency = job_kind + ":" + tenant_window
    replay_value = "code:" + idempotency
    return CodeJobContract(job_kind, "code_maintenance_agent", job_kind + "Input", job_kind + "Output", 5, 0.50, approval_label, needs_review, idempotency, replay_value)

public @replayable
agent code_run(contract: CodeJobContract, input_fingerprint: String, output_fingerprint: String, plan_id: String, action_kind: String) -> CodeJobRun:
    state = pending_job_state(contract.idempotency_key, contract.queue_name, contract.job_kind, contract.max_attempts, contract.budget_usd, contract.needs_review, contract.idempotency_key, contract.replay_key)
    input = job_input(contract.job_kind, input_fingerprint, contract.input_schema)
    output = job_output(output_fingerprint, contract.output_schema)
    retry_plan = retry_policy(contract.max_attempts, "exponential_jitter", 1000, 600000, "code_maintenance_agent.dead_letter")
    effect_meta = effect_envelope("code_maintenance_agent." + contract.job_kind, "workspace:" + contract.queue_name, contract.approval_label, contract.idempotency_key, contract.replay_key)
    plan = plan_step(plan_id, "bounded code maintenance job step", "code_maintenance_agent")
    action = action_request(action_kind, contract.idempotency_key, contract.approval_label, contract.needs_review)
    review = review_verdict(true, "", "contract bounded by retry, budget, idempotency, and replay")
    return CodeJobRun(contract, state, input, output, retry_plan, effect_meta, plan, action, review)

public @replayable
agent hourly_ci_signal_scan_job(tenant_id: String, window: String) -> CodeJobRun uses ci_read:
    contract = code_contract("hourly_ci_signal_scan", tenant_id + ":" + window, "", false)
    return code_run(contract, "sha256:ci_signal_scan_input", "sha256:ci_signal_scan_output", "ci_scan.plan", "label_failing_ci")

public @replayable
agent nightly_repo_reindex_job(tenant_id: String, repo: String) -> CodeJobRun uses repo_read:
    contract = code_contract("nightly_repo_reindex", tenant_id + ":" + repo, "", false)
    return code_run(contract, "sha256:repo_reindex_input", "sha256:repo_reindex_output", "repo_reindex.plan", "refresh_repo_tree")

public @replayable
agent weekly_stale_issue_sweep_job(tenant_id: String, window: String) -> CodeJobRun uses repo_read:
    contract = code_contract("weekly_stale_issue_sweep", tenant_id + ":" + window, "", false)
    return code_run(contract, "sha256:stale_issue_input", "sha256:stale_issue_output", "stale_sweep.plan", "flag_stale_issues")

public @replayable
agent code_job_contract_valid(run: CodeJobRun) -> Bool:
    return retry_policy_valid(run.retry_plan) and job_metadata_redacted(run.input, run.output) and replay_safe(run.effect_meta) and run.state.budget_usd <= run.contract.budget_usd and run.state.idempotency_key == run.contract.idempotency_key

# Typed permission per dangerous tool. The auth surface (sessions +
# API keys + per-tenant + per-role) propagates these through Actor
# permissions; the strings here are the canonical identifiers any auth
# check refers to. One distinct permission per dangerous tool closes
# the maturity-bar requirement of "≥1 typed permission per dangerous
# tool".
public @replayable
agent permission_for_post_review_comment() -> String:
    return "code.tool.post_review_comment"

public @replayable
agent permission_for_create_patch_proposal() -> String:
    return "code.tool.create_patch_proposal"

public @replayable
agent permission_for_open_pull_request() -> String:
    return "code.tool.open_pull_request"

public @replayable
agent permission_for_merge_pull_request() -> String:
    return "code.tool.merge_pull_request"

public @replayable
agent permission_for_tag_release() -> String:
    return "code.tool.tag_release"

public @replayable
agent dangerous_tool_permissions_distinct() -> Bool:
    a = permission_for_post_review_comment()
    b = permission_for_create_patch_proposal()
    c = permission_for_open_pull_request()
    d = permission_for_merge_pull_request()
    e = permission_for_tag_release()
    ab = a != b
    ac = a != c
    ad = a != d
    ae = a != e
    bc = b != c
    bd = b != d
    be = b != e
    cd = c != d
    ce = c != e
    de = d != e
    return ab and ac and ad and ae and bc and bd and be and cd and ce and de

public @replayable
agent code_schema_manifest() -> CodeSchemaManifest:
    return CodeSchemaManifest("code_maintenance_agent", 5, 21, 3, 3, 5, "mock", true)

public @replayable
agent demo_repo() -> RepoSnapshot uses repo_read:
    return RepoSnapshot("repo-1", "tenant-1", "github", "org/app", "abc123", "sha256:tree-demo")

public @replayable
agent demo_issue() -> IssueSnapshot uses repo_read:
    repo = demo_repo()
    return IssueSnapshot("issue-1", repo.tenant_id, repo.id, "sha256:issue-title", "sha256:issue-body", "open")

public @replayable
agent demo_ci_signal() -> CiSignal uses ci_read:
    repo = demo_repo()
    return CiSignal("ci-1", repo.id, repo.commit_sha, "failed", "unit-tests", "sha256:ci-log")

public @replayable
agent triage_issue_mock() -> CodeRiskLabel uses repo_read, ci_read, code_ai:
    issue = demo_issue()
    ci = demo_ci_signal()
    return CodeRiskLabel(issue, ci, "test_regression", "high", 0.87, "code:triage:issue-1")

public @replayable
agent code_triage_valid(label: CodeRiskLabel) -> Bool:
    return label.ci.status == "failed" and label.severity == "high" and label.confidence >= 0.8 and label.replay_key == "code:triage:issue-1"

public @replayable
agent code_write_plan_mock() -> CodeWritePlan uses repo_read, ci_read, code_ai:
    risk = triage_issue_mock()
    return CodeWritePlan(risk, "sha256:review-comment", "sha256:patch-proposal", 2, true)

agent execute_approved_review_comment(req: ReviewCommentRequest) -> ReviewCommentReceipt uses code_write:
    approve PostReviewComment(req)
    return post_review_comment(req)

agent execute_approved_patch_proposal(req: PatchProposalRequest) -> PatchProposalReceipt uses code_write:
    approve CreatePatchProposal(req)
    return create_patch_proposal(req)

public @replayable
agent code_write_plan_valid(plan: CodeWritePlan) -> Bool:
    return plan.writes_gated and plan.approval_count == 2 and plan.patch_fingerprint != "" and plan.review_comment_fingerprint != ""

# Developer-authored approval flow. Each contract below is the
# developer's explicit choice — role, cost ceiling, data class,
# irreversibility, and expiry are declared in source. Review comments
# and patch proposals are reversible proposals; merging a PR or tagging
# a release changes the mainline / published state and is irreversible.
# Corvid enforces the `approve <Label>` boundary; it never decides the
# flow.
public @replayable
agent post_review_comment_approval_contract(tenant_id: String, issue_id: String, trace_id: String) -> ApprovalContractRef:
    return approval_contract_ref("review-comment:" + issue_id, "v1", "PostReviewComment", "issue", issue_id, tenant_id, "Reviewer", 0.05, "code", false, 4102444800000, "approval:review_comment:" + trace_id)

public @replayable
agent create_patch_proposal_approval_contract(tenant_id: String, repo_id: String, trace_id: String) -> ApprovalContractRef:
    return approval_contract_ref("patch-proposal:" + repo_id, "v1", "CreatePatchProposal", "repo", repo_id, tenant_id, "Reviewer", 0.05, "code", false, 4102444800000, "approval:patch_proposal:" + trace_id)

public @replayable
agent open_pull_request_approval_contract(tenant_id: String, repo_id: String, trace_id: String) -> ApprovalContractRef:
    return approval_contract_ref("open-pr:" + repo_id, "v1", "OpenPullRequest", "repo", repo_id, tenant_id, "Reviewer", 0.05, "code", false, 4102444800000, "approval:open_pr:" + trace_id)

public @replayable
agent merge_pull_request_approval_contract(tenant_id: String, repo_id: String, trace_id: String) -> ApprovalContractRef:
    return approval_contract_ref("merge-pr:" + repo_id, "v1", "MergePullRequest", "repo", repo_id, tenant_id, "Admin", 0.25, "code", true, 4102444800000, "approval:merge_pr:" + trace_id)

public @replayable
agent tag_release_approval_contract(tenant_id: String, repo_id: String, trace_id: String) -> ApprovalContractRef:
    return approval_contract_ref("tag-release:" + repo_id, "v1", "TagRelease", "repo", repo_id, tenant_id, "Admin", 0.25, "code", true, 4102444800000, "approval:tag_release:" + trace_id)

agent execute_approved_open_pull_request(req: OpenPullRequestRequest) -> OpenPullRequestReceipt uses pr_write:
    approve OpenPullRequest(req)
    return open_pull_request(req)

agent execute_approved_merge_pull_request(req: MergePullRequestRequest) -> MergePullRequestReceipt uses merge_write:
    approve MergePullRequest(req)
    return merge_pull_request(req)

agent execute_approved_tag_release(req: TagReleaseRequest) -> TagReleaseReceipt uses release_write:
    approve TagRelease(req)
    return tag_release(req)

public @replayable
agent approval_surface_valid(tenant_id: String, trace_id: String) -> Bool:
    a = post_review_comment_approval_contract(tenant_id, "issue-1", trace_id)
    b = create_patch_proposal_approval_contract(tenant_id, "repo-1", trace_id)
    c = open_pull_request_approval_contract(tenant_id, "repo-1", trace_id)
    d = merge_pull_request_approval_contract(tenant_id, "repo-1", trace_id)
    e = tag_release_approval_contract(tenant_id, "repo-1", trace_id)
    comment_ok = a.action == "PostReviewComment" and a.required_role == "Reviewer" and a.data_class == "code"
    patch_ok = b.action == "CreatePatchProposal" and b.required_role == "Reviewer" and b.data_class == "code"
    pr_ok = c.action == "OpenPullRequest" and c.required_role == "Reviewer" and c.data_class == "code"
    merge_ok = d.action == "MergePullRequest" and d.required_role == "Admin" and d.data_class == "code" and d.irreversible
    release_ok = e.action == "TagRelease" and e.required_role == "Admin" and e.data_class == "code" and e.irreversible
    return comment_ok and patch_ok and pr_ok and merge_ok and release_ok

server code_maintenance_agent_api:
    route GET "/config" -> json CodeConfig:
        return code_config()
    route GET "/schema" -> json CodeSchemaManifest:
        return code_schema_manifest()
    route GET "/repos/ingest/mock" -> json RepoSnapshot uses repo_read:
        return demo_repo()
    route GET "/issues/triage/mock" -> json CodeRiskLabel uses repo_read, ci_read, code_ai:
        return triage_issue_mock()
    route GET "/writes/plan/mock" -> json CodeWritePlan uses repo_read, ci_read, code_ai:
        return code_write_plan_mock()
    route POST "/comments/post" body ReviewCommentRequest -> json ReviewCommentReceipt uses code_write:
        return execute_approved_review_comment(body)
    route POST "/patches/propose" body PatchProposalRequest -> json PatchProposalReceipt uses code_write:
        return execute_approved_patch_proposal(body)
    route POST "/pull-requests/open" body OpenPullRequestRequest -> json OpenPullRequestReceipt uses pr_write:
        return execute_approved_open_pull_request(body)
    route POST "/pull-requests/merge" body MergePullRequestRequest -> json MergePullRequestReceipt uses merge_write:
        return execute_approved_merge_pull_request(body)
    route POST "/releases/tag" body TagReleaseRequest -> json TagReleaseReceipt uses release_write:
        return execute_approved_tag_release(body)
    route POST "/auth/session/login" body LoginRequest -> json LoginResponse:
        return session_login(body)
    route POST "/auth/api-key/login" body ApiKeyLoginRequest -> json ApiKeyLoginResponse:
        return api_key_login(body)
    route GET "/auth/status" -> json AuthStatusResponse:
        return auth_status("user-1", "tenant-1", "trace-auth-status")
    route GET "/auth/api-key/status" -> json AuthStatusResponse:
        return api_key_auth_status("service-1", "tenant-1", "trace-api-key-status")
    route GET "/jobs/hourly-ci-signal-scan/mock" -> json CodeJobRun uses ci_read:
        return hourly_ci_signal_scan_job("tenant-1", "business_hour")
    route GET "/jobs/nightly-repo-reindex/mock" -> json CodeJobRun uses repo_read:
        return nightly_repo_reindex_job("tenant-1", "org/app")
    route GET "/jobs/weekly-stale-issue-sweep/mock" -> json CodeJobRun uses repo_read:
        return weekly_stale_issue_sweep_job("tenant-1", "business_week")

schedule "0 * * * *" zone "America/New_York" -> hourly_ci_signal_scan_job("tenant-1", "business_hour") uses ci_read
schedule "0 2 * * *" zone "America/New_York" -> nightly_repo_reindex_job("tenant-1", "org/app") uses repo_read
schedule "0 6 * * 1" zone "America/New_York" -> weekly_stale_issue_sweep_job("tenant-1", "business_week") uses repo_read

# Directly-embeddable C-ABI entrypoint (see PKA). The full struct-typed
# surface (auth / jobs / approvals / review-write) rides the catalog ABI.
@budget($1.00)
pub extern "c"
agent triage(summary: String) -> String:
    label = triage_issue_mock()
    return "code:" + summary + ":" + label.category + ":" + label.severity

agent main() -> Bool:
    label = triage_issue_mock()
    plan = code_write_plan_mock()
    auth = auth_status("user-1", "tenant-1", "trace-main-auth")
    service_auth = api_key_auth_status("service-1", "tenant-1", "trace-main-api-key")
    ci_scan = hourly_ci_signal_scan_job("tenant-1", "business_hour")
    repo_reindex = nightly_repo_reindex_job("tenant-1", "org/app")
    stale_sweep = weekly_stale_issue_sweep_job("tenant-1", "business_week")
    approvals_ok = approval_surface_valid("tenant-1", "trace-main-approvals")
    permissions_ok = dangerous_tool_permissions_distinct()
    return code_triage_valid(label) and code_write_plan_valid(plan) and auth.authenticated and service_auth.authenticated and code_job_contract_valid(ci_scan) and code_job_contract_valid(repo_reindex) and code_job_contract_valid(stale_sweep) and approvals_ok and permissions_ok
