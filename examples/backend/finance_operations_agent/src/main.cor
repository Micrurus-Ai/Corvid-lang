tool submit_payment_intent(req: PaymentIntentRequest) -> PaymentIntentReceipt dangerous uses payment_write
tool cancel_subscription(req: CancelSubscriptionRequest) -> CancelSubscriptionReceipt dangerous uses subscription_write
tool dispute_transaction(req: DisputeTransactionRequest) -> DisputeTransactionReceipt dangerous uses dispute_write
tool export_financial_report(req: ExportFinancialReportRequest) -> ExportFinancialReportReceipt dangerous uses report_export
tool schedule_recurring_payment(req: ScheduleRecurringPaymentRequest) -> ScheduleRecurringPaymentReceipt dangerous uses recurring_payment_write

public @replayable
agent finance_config() -> FinanceConfig:
    return FinanceConfig("finance_operations_agent", "mock", false, true)

public @replayable
agent session_login(req: LoginRequest) -> LoginResponse:
    actor = user_actor(req.actor_id, req.tenant_id, req.display_name, "role:finance_operator", "perm:finance.read:finance.operate", req.trace_id)
    sess = session_ref(req.session_id, actor.id, actor.tenant_id, 0, 4102444800000, 0, req.csrf_binding_id, req.trace_id)
    trace = auth_trace_for_session(actor, sess, "auth:session:" + req.session_id)
    decision = allow_permission(actor, trace, "finance.readonly.read")
    return LoginResponse(actor, sess, trace, decision, "authenticated")

public @replayable
agent api_key_login(req: ApiKeyLoginRequest) -> ApiKeyLoginResponse:
    actor = service_actor(req.service_actor_id, req.tenant_id, req.display_name, "scope:finance.jobs.run", req.trace_id)
    key = api_key_ref(req.api_key_id, actor.id, actor.tenant_id, "scope:finance.jobs.run", "argon2id", 4102444800000, 0, req.trace_id)
    trace = auth_trace_for_api_key(actor, key, "auth:api_key:" + req.api_key_id)
    decision = allow_permission(actor, trace, "finance.jobs.run")
    return ApiKeyLoginResponse(actor, key, trace, decision, "authenticated")

public @replayable
agent auth_status(actor_id: String, tenant_id: String, trace_id: String) -> AuthStatusResponse:
    actor = user_actor(actor_id, tenant_id, "Finance Operator", "role:finance_operator", "perm:finance.read", trace_id)
    sess = session_ref("session-status", actor.id, actor.tenant_id, 0, 4102444800000, 0, "csrf-status", trace_id)
    trace = auth_trace_for_session(actor, sess, "auth:status:" + trace_id)
    active = session_active(sess, 1) and auth_trace_same_tenant(trace, actor)
    decision = allow_permission(actor, trace, "finance.readonly.read")
    if active:
        return AuthStatusResponse(actor, actor.tenant_id, decision.allowed, decision.permission, decision.reason, trace.replay_key)
    denied = deny_permission(actor, trace, "finance.readonly.read", "session inactive")
    return AuthStatusResponse(actor, actor.tenant_id, false, denied.permission, denied.reason, trace.replay_key)

public @replayable
agent api_key_auth_status(actor_id: String, tenant_id: String, trace_id: String) -> AuthStatusResponse:
    actor = service_actor(actor_id, tenant_id, "Finance Service", "scope:finance.jobs.run", trace_id)
    key = api_key_ref("api-key-status", actor.id, actor.tenant_id, "scope:finance.jobs.run", "argon2id", 4102444800000, 0, trace_id)
    trace = auth_trace_for_api_key(actor, key, "auth:api_key_status:" + trace_id)
    active = api_key_active(key, 1) and auth_trace_same_tenant(trace, actor)
    decision = allow_permission(actor, trace, "finance.jobs.run")
    if active:
        return AuthStatusResponse(actor, actor.tenant_id, decision.allowed, decision.permission, decision.reason, trace.replay_key)
    denied = deny_permission(actor, trace, "finance.jobs.run", "api key inactive")
    return AuthStatusResponse(actor, actor.tenant_id, false, denied.permission, denied.reason, trace.replay_key)

public @replayable
agent finance_contract(job_kind: String, tenant_window: String, approval_label: String, needs_review: Bool) -> FinanceJobContract:
    idempotency = job_kind + ":" + tenant_window
    replay_value = "finance:" + idempotency
    return FinanceJobContract(job_kind, "finance_operations_agent", job_kind + "Input", job_kind + "Output", 5, 0.50, approval_label, needs_review, idempotency, replay_value)

public @replayable
agent finance_run(contract: FinanceJobContract, input_fingerprint: String, output_fingerprint: String, plan_id: String, action_kind: String) -> FinanceJobRun:
    state = pending_job_state(contract.idempotency_key, contract.queue_name, contract.job_kind, contract.max_attempts, contract.budget_usd, contract.needs_review, contract.idempotency_key, contract.replay_key)
    input = job_input(contract.job_kind, input_fingerprint, contract.input_schema)
    output = job_output(output_fingerprint, contract.output_schema)
    retry_plan = retry_policy(contract.max_attempts, "exponential_jitter", 1000, 600000, "finance_operations_agent.dead_letter")
    effect_meta = effect_envelope("finance_operations_agent." + contract.job_kind, "workspace:" + contract.queue_name, contract.approval_label, contract.idempotency_key, contract.replay_key)
    plan = plan_step(plan_id, "bounded read-only finance job step", "finance_operations_agent")
    action = action_request(action_kind, contract.idempotency_key, contract.approval_label, contract.needs_review)
    review = review_verdict(true, "", "contract bounded by retry, budget, idempotency, and replay")
    return FinanceJobRun(contract, state, input, output, retry_plan, effect_meta, plan, action, review)

public @replayable
agent nightly_balance_sync_job(tenant_id: String, provider: String) -> FinanceJobRun uses finance_read:
    contract = finance_contract("nightly_balance_sync", tenant_id + ":" + provider, "", false)
    return finance_run(contract, "sha256:nightly_balance_sync_input", "sha256:nightly_balance_sync_output", "balance_sync.plan", "resync_account_balances")

public @replayable
agent weekly_anomaly_scan_job(tenant_id: String, window: String) -> FinanceJobRun uses finance_read, finance_ai:
    contract = finance_contract("weekly_anomaly_scan", tenant_id + ":" + window, "", false)
    return finance_run(contract, "sha256:weekly_anomaly_scan_input", "sha256:weekly_anomaly_scan_output", "anomaly_scan.plan", "flag_spend_anomalies")

public @replayable
agent daily_subscription_renewal_check_job(tenant_id: String, day: String) -> FinanceJobRun uses finance_read:
    contract = finance_contract("daily_subscription_renewal_check", tenant_id + ":" + day, "", false)
    return finance_run(contract, "sha256:subscription_renewal_input", "sha256:subscription_renewal_output", "renewal_check.plan", "surface_upcoming_renewals")

public @replayable
agent finance_job_contract_valid(run: FinanceJobRun) -> Bool:
    return retry_policy_valid(run.retry_plan) and job_metadata_redacted(run.input, run.output) and replay_safe(run.effect_meta) and run.state.budget_usd <= run.contract.budget_usd and run.state.idempotency_key == run.contract.idempotency_key

public @replayable
agent finance_schema_manifest() -> FinanceSchemaManifest:
    return FinanceSchemaManifest("finance_operations_agent", 5, 23, 3, 3, 5, "mock", true)

public @replayable
agent demo_account() -> FinanceAccount uses finance_read:
    return FinanceAccount("acct-1", "tenant-1", "mock_bank", "Operating", 250000, "USD", "sha256:account-demo")

public @replayable
agent demo_budget() -> FinanceBudget uses finance_read:
    return FinanceBudget("budget-1", "tenant-1", "software", 50000, 42000, "watch")

public @replayable
agent demo_subscription() -> FinanceSubscription uses finance_read:
    return FinanceSubscription("sub-1", "tenant-1", "Cloud Tools", 9900, "monthly", "2026-05-01", "active")

public @replayable
agent demo_reminder() -> FinanceReminder uses finance_read:
    return FinanceReminder("reminder-1", "tenant-1", "subscription_renewal", "2026-04-30", "sha256:renewal-reminder")

public @replayable
agent demo_anomaly() -> FinanceAnomaly uses finance_read, finance_ai:
    return FinanceAnomaly("anomaly-1", "tenant-1", "acct-1", "software", 18000, 0.86, "sha256:anomaly-explanation")

public @replayable
agent readonly_snapshot() -> FinanceReadonlySnapshot uses finance_read, finance_ai:
    account = demo_account()
    budget = demo_budget()
    subscription = demo_subscription()
    reminder = demo_reminder()
    anomaly = demo_anomaly()
    return FinanceReadonlySnapshot(account, budget, subscription, reminder, anomaly, account.balance_cents, true, true)

public @replayable
agent readonly_snapshot_valid(snapshot: FinanceReadonlySnapshot) -> Bool:
    return snapshot.readonly and snapshot.non_advice and snapshot.total_balance_cents == snapshot.account.balance_cents and snapshot.anomaly.confidence >= 0.8

public @replayable
agent demo_payment_intent() -> FinancePaymentIntent:
    return FinancePaymentIntent("intent-1", "tenant-1", "acct-1", "sha256:payee-demo", 12500, "USD", "SubmitPaymentIntent", "approval_pending", true)

public @replayable
agent demo_payment_audit() -> FinanceAuditRecord:
    return FinanceAuditRecord("audit-1", "tenant-1", "user-1", "SubmitPaymentIntent", "draft", "approval_pending", "approval:intent-1", "trace-payment-intent", true)

public @replayable
agent payment_approval_surface() -> FinanceApprovalAuditSurface:
    intent = demo_payment_intent()
    audit = demo_payment_audit()
    return FinanceApprovalAuditSurface(intent, audit, intent.approval_label == audit.action and audit.redacted, false, intent.non_advice)

agent execute_approved_payment_intent(req: PaymentIntentRequest) -> PaymentIntentReceipt uses payment_write:
    approve SubmitPaymentIntent(req)
    return submit_payment_intent(req)

public @replayable
agent payment_approval_surface_valid(surface: FinanceApprovalAuditSurface) -> Bool:
    return surface.ready_for_approval and not surface.execute_without_approval and surface.non_advice and surface.intent.status == "approval_pending"

# Developer-authored approval flow. Each contract below is the
# developer's explicit choice — role, cost ceiling, data class,
# irreversibility, and expiry are all declared in source, not handed
# to an opaque built-in. Corvid's job is to give the developer this
# control and then compiler-enforce the `approve <Label>` gate; it
# never decides the flow for them. Every surface executes a decision a
# human with the right role made — none of them advises.
public @replayable
agent submit_payment_intent_approval_contract(tenant_id: String, payee: String, trace_id: String) -> ApprovalContractRef:
    return approval_contract_ref("submit-payment:" + payee, "v1", "SubmitPaymentIntent", "payee", payee, tenant_id, "Admin", 0.25, "financial", true, 4102444800000, "approval:submit_payment:" + trace_id)

public @replayable
agent cancel_subscription_approval_contract(tenant_id: String, subscription_id: String, trace_id: String) -> ApprovalContractRef:
    return approval_contract_ref("cancel-subscription:" + subscription_id, "v1", "CancelSubscription", "subscription", subscription_id, tenant_id, "Reviewer", 0.05, "financial", false, 4102444800000, "approval:cancel_subscription:" + trace_id)

public @replayable
agent dispute_transaction_approval_contract(tenant_id: String, account_id: String, trace_id: String) -> ApprovalContractRef:
    return approval_contract_ref("dispute-transaction:" + account_id, "v1", "DisputeTransaction", "transaction", account_id, tenant_id, "Reviewer", 0.05, "financial", false, 4102444800000, "approval:dispute_transaction:" + trace_id)

public @replayable
agent export_financial_report_approval_contract(tenant_id: String, export_destination: String, trace_id: String) -> ApprovalContractRef:
    return approval_contract_ref("export-report:" + export_destination, "v1", "ExportFinancialReport", "export_target", export_destination, tenant_id, "Admin", 0.25, "financial", true, 4102444800000, "approval:export_report:" + trace_id)

public @replayable
agent schedule_recurring_payment_approval_contract(tenant_id: String, payee: String, trace_id: String) -> ApprovalContractRef:
    return approval_contract_ref("schedule-recurring:" + payee, "v1", "ScheduleRecurringPayment", "payee", payee, tenant_id, "Admin", 0.25, "financial", true, 4102444800000, "approval:schedule_recurring:" + trace_id)

agent execute_approved_cancel_subscription(req: CancelSubscriptionRequest) -> CancelSubscriptionReceipt uses subscription_write:
    approve CancelSubscription(req)
    return cancel_subscription(req)

agent execute_approved_dispute_transaction(req: DisputeTransactionRequest) -> DisputeTransactionReceipt uses dispute_write:
    approve DisputeTransaction(req)
    return dispute_transaction(req)

agent execute_approved_export_financial_report(req: ExportFinancialReportRequest) -> ExportFinancialReportReceipt uses report_export:
    approve ExportFinancialReport(req)
    return export_financial_report(req)

agent execute_approved_schedule_recurring_payment(req: ScheduleRecurringPaymentRequest) -> ScheduleRecurringPaymentReceipt uses recurring_payment_write:
    approve ScheduleRecurringPayment(req)
    return schedule_recurring_payment(req)

public @replayable
agent approval_surface_valid(tenant_id: String, trace_id: String) -> Bool:
    a = submit_payment_intent_approval_contract(tenant_id, "payee-1", trace_id)
    b = cancel_subscription_approval_contract(tenant_id, "sub-1", trace_id)
    c = dispute_transaction_approval_contract(tenant_id, "acct-1", trace_id)
    d = export_financial_report_approval_contract(tenant_id, "s3://finance-exports/report", trace_id)
    e = schedule_recurring_payment_approval_contract(tenant_id, "payee-1", trace_id)
    payment_ok = a.action == "SubmitPaymentIntent" and a.required_role == "Admin" and a.data_class == "financial" and a.irreversible
    cancel_ok = b.action == "CancelSubscription" and b.required_role == "Reviewer" and b.data_class == "financial"
    dispute_ok = c.action == "DisputeTransaction" and c.required_role == "Reviewer" and c.data_class == "financial"
    export_ok = d.action == "ExportFinancialReport" and d.required_role == "Admin" and d.data_class == "financial" and d.irreversible
    recurring_ok = e.action == "ScheduleRecurringPayment" and e.required_role == "Admin" and e.data_class == "financial" and e.irreversible
    return payment_ok and cancel_ok and dispute_ok and export_ok and recurring_ok

server finance_operations_agent_api:
    route GET "/config" -> json FinanceConfig:
        return finance_config()
    route GET "/schema" -> json FinanceSchemaManifest:
        return finance_schema_manifest()
    route GET "/readonly/snapshot/mock" -> json FinanceReadonlySnapshot uses finance_read, finance_ai:
        return readonly_snapshot()
    route GET "/payments/intents/mock" -> json FinanceApprovalAuditSurface:
        return payment_approval_surface()
    route POST "/payments/intents/submit" body PaymentIntentRequest -> json PaymentIntentReceipt uses payment_write:
        return execute_approved_payment_intent(body)
    route POST "/subscriptions/cancel" body CancelSubscriptionRequest -> json CancelSubscriptionReceipt uses subscription_write:
        return execute_approved_cancel_subscription(body)
    route POST "/transactions/dispute" body DisputeTransactionRequest -> json DisputeTransactionReceipt uses dispute_write:
        return execute_approved_dispute_transaction(body)
    route POST "/reports/export" body ExportFinancialReportRequest -> json ExportFinancialReportReceipt uses report_export:
        return execute_approved_export_financial_report(body)
    route POST "/payments/recurring/schedule" body ScheduleRecurringPaymentRequest -> json ScheduleRecurringPaymentReceipt uses recurring_payment_write:
        return execute_approved_schedule_recurring_payment(body)
    route POST "/auth/session/login" body LoginRequest -> json LoginResponse:
        return session_login(body)
    route POST "/auth/api-key/login" body ApiKeyLoginRequest -> json ApiKeyLoginResponse:
        return api_key_login(body)
    route GET "/auth/status" -> json AuthStatusResponse:
        return auth_status("user-1", "tenant-1", "trace-auth-status")
    route GET "/auth/api-key/status" -> json AuthStatusResponse:
        return api_key_auth_status("service-1", "tenant-1", "trace-api-key-status")
    route GET "/jobs/nightly-balance-sync/mock" -> json FinanceJobRun uses finance_read:
        return nightly_balance_sync_job("tenant-1", "mock_bank")
    route GET "/jobs/weekly-anomaly-scan/mock" -> json FinanceJobRun uses finance_read, finance_ai:
        return weekly_anomaly_scan_job("tenant-1", "business_week")
    route GET "/jobs/daily-subscription-renewal-check/mock" -> json FinanceJobRun uses finance_read:
        return daily_subscription_renewal_check_job("tenant-1", "2026-05-28")

schedule "0 2 * * *" zone "America/New_York" -> nightly_balance_sync_job("tenant-1", "mock_bank") uses finance_read
schedule "0 6 * * 1" zone "America/New_York" -> weekly_anomaly_scan_job("tenant-1", "business_week") uses finance_read, finance_ai
schedule "0 7 * * *" zone "America/New_York" -> daily_subscription_renewal_check_job("tenant-1", "business_day") uses finance_read

agent main() -> Bool:
    snapshot = readonly_snapshot()
    payment = payment_approval_surface()
    auth = auth_status("user-1", "tenant-1", "trace-main-auth")
    service_auth = api_key_auth_status("service-1", "tenant-1", "trace-main-api-key")
    balance_sync = nightly_balance_sync_job("tenant-1", "mock_bank")
    anomaly_scan = weekly_anomaly_scan_job("tenant-1", "business_week")
    renewal_check = daily_subscription_renewal_check_job("tenant-1", "business_day")
    approvals_ok = approval_surface_valid("tenant-1", "trace-main-approvals")
    return readonly_snapshot_valid(snapshot) and payment_approval_surface_valid(payment) and auth.authenticated and service_auth.authenticated and finance_job_contract_valid(balance_sync) and finance_job_contract_valid(anomaly_scan) and finance_job_contract_valid(renewal_check) and approvals_ok
