# Personal Executive Agent — hardening eval suite.
#
# Encodes the per-app maturity bar as typed structural invariants the
# eval interpreter can verify deterministically. Each agent below
# returns the expected shape; each `assert` in the eval block fails
# loudly if the shape drifts. The agents are self-contained — they
# do not depend on `src/main.cor` compiling, so the eval suite runs
# even while the workspace stdlib import path is still under repair
# (see D-PEA-4).
#
# Three fixture files under `evals/promoted/` are the trace-derived
# regression set produced by `corvid eval promote
# <trace>.lineage.jsonl --promote-out evals/promoted`. Each carries
# a `corvid.eval.lineage_fixture.v1` shape with the recorded events,
# selected span ids, and expected guarantee/effect ids.

type ExecutiveMaturityBar:
    min_migrations: Int
    min_tables: Int
    min_connectors: Int
    min_jobs: Int
    min_approvals: Int
    min_adversarial_threats: Int
    min_cron_jobs: Int
    max_job_budget_usd: Float

type ExecutiveManifestShape:
    migration_count: Int
    table_count: Int
    connector_count: Int
    job_count: Int
    approval_count: Int
    default_mode: String

type ApprovalContractShape:
    label: String
    required_role: String
    cost_ceiling_usd: Float
    irreversible: Bool
    expires_in_hours: Int

type CronSchedule:
    cron_expr: String
    time_zone: String
    job_name: String

type JobContractShape:
    job_kind: String
    queue_name: String
    max_attempts: Int
    budget_usd: Float
    has_replay_key: Bool

agent expected_maturity_bar() -> ExecutiveMaturityBar:
    return ExecutiveMaturityBar(5, 10, 3, 3, 5, 5, 3, 0.75)

agent expected_manifest() -> ExecutiveManifestShape:
    return ExecutiveManifestShape(5, 12, 5, 4, 5, "mock")

agent send_follow_up_email_approval() -> ApprovalContractShape:
    return ApprovalContractShape("SendFollowUpEmail", "Reviewer", 0.25, true, 24)

agent edit_calendar_event_approval() -> ApprovalContractShape:
    return ApprovalContractShape("EditCalendarEvent", "Reviewer", 0.25, true, 24)

agent edit_task_item_approval() -> ApprovalContractShape:
    return ApprovalContractShape("EditTaskItem", "Reviewer", 0.10, true, 24)

agent send_chat_message_approval() -> ApprovalContractShape:
    return ApprovalContractShape("SendChatMessage", "Reviewer", 0.10, true, 24)

agent external_calendar_share_approval() -> ApprovalContractShape:
    return ApprovalContractShape("ExternalCalendarShare", "Admin", 0.25, true, 24)

agent daily_brief_schedule() -> CronSchedule:
    return CronSchedule("0 7 * * 1-5", "America/New_York", "daily_brief_job")

agent meeting_prep_schedule() -> CronSchedule:
    return CronSchedule("0 6 * * 1-5", "America/New_York", "meeting_prep_job")

agent email_triage_schedule() -> CronSchedule:
    return CronSchedule("*/10 8-18 * * 1-5", "America/New_York", "email_triage_job")

agent follow_up_schedule() -> CronSchedule:
    return CronSchedule("*/15 8-18 * * 1-5", "America/New_York", "follow_up_job")

agent daily_brief_job_contract() -> JobContractShape:
    return JobContractShape("daily_brief", "personal_executive_agent", 5, 0.75, true)

agent meeting_prep_job_contract() -> JobContractShape:
    return JobContractShape("meeting_prep", "personal_executive_agent", 5, 0.75, true)

agent email_triage_job_contract() -> JobContractShape:
    return JobContractShape("email_triage", "personal_executive_agent", 5, 0.75, true)

agent follow_up_job_contract() -> JobContractShape:
    return JobContractShape("follow_up", "personal_executive_agent", 5, 0.75, true)

# Case 1: schema manifest matches the per-app maturity bar minima.
agent case_schema_manifest_meets_maturity_bar() -> Bool:
    manifest = expected_manifest()
    bar = expected_maturity_bar()
    migrations_ok = manifest.migration_count >= bar.min_migrations
    tables_ok = manifest.table_count >= bar.min_tables
    connectors_ok = manifest.connector_count >= bar.min_connectors
    jobs_ok = manifest.job_count >= bar.min_jobs
    approvals_ok = manifest.approval_count >= bar.min_approvals
    mode_ok = manifest.default_mode == "mock"
    return migrations_ok and tables_ok and connectors_ok and jobs_ok and approvals_ok and mode_ok

# Case 2: five distinct approval contracts present (closes the 4->5
# gap the maturity-bar audit flagged).
agent case_five_distinct_approval_contracts() -> Bool:
    a = send_follow_up_email_approval()
    b = edit_calendar_event_approval()
    c = edit_task_item_approval()
    d = send_chat_message_approval()
    e = external_calendar_share_approval()
    labels_match = a.label == "SendFollowUpEmail" and b.label == "EditCalendarEvent" and c.label == "EditTaskItem" and d.label == "SendChatMessage" and e.label == "ExternalCalendarShare"
    distinct_ab = a.label != b.label
    distinct_bc = b.label != c.label
    distinct_cd = c.label != d.label
    distinct_de = d.label != e.label
    return labels_match and distinct_ab and distinct_bc and distinct_cd and distinct_de

# Case 3: every approval contract is irreversible and expires within
# the day. Catches the "approval was relaxed to reversible" drift.
agent case_every_approval_irreversible_and_short_expiry() -> Bool:
    a = send_follow_up_email_approval()
    b = edit_calendar_event_approval()
    c = edit_task_item_approval()
    d = send_chat_message_approval()
    e = external_calendar_share_approval()
    all_irreversible = a.irreversible and b.irreversible and c.irreversible and d.irreversible and e.irreversible
    a_expires = a.expires_in_hours <= 24
    b_expires = b.expires_in_hours <= 24
    c_expires = c.expires_in_hours <= 24
    d_expires = d.expires_in_hours <= 24
    e_expires = e.expires_in_hours <= 24
    return all_irreversible and a_expires and b_expires and c_expires and d_expires and e_expires

# Case 4: approval cost ceilings are non-zero and bounded. Catches
# a regression that opens "approval with no cost cap" by mistake.
agent case_approval_cost_ceilings_bounded() -> Bool:
    a = send_follow_up_email_approval()
    b = edit_calendar_event_approval()
    c = edit_task_item_approval()
    d = send_chat_message_approval()
    e = external_calendar_share_approval()
    a_ok = a.cost_ceiling_usd > 0.0 and a.cost_ceiling_usd <= 1.00
    b_ok = b.cost_ceiling_usd > 0.0 and b.cost_ceiling_usd <= 1.00
    c_ok = c.cost_ceiling_usd > 0.0 and c.cost_ceiling_usd <= 1.00
    d_ok = d.cost_ceiling_usd > 0.0 and d.cost_ceiling_usd <= 1.00
    e_ok = e.cost_ceiling_usd > 0.0 and e.cost_ceiling_usd <= 1.00
    return a_ok and b_ok and c_ok and d_ok and e_ok

# Case 5: every external-write approval requires at least the
# Reviewer role. ExternalCalendarShare additionally requires Admin
# because it shares with parties outside the tenant.
agent case_external_write_approvals_require_reviewer_or_admin() -> Bool:
    a = send_follow_up_email_approval()
    b = edit_calendar_event_approval()
    c = edit_task_item_approval()
    d = send_chat_message_approval()
    e = external_calendar_share_approval()
    a_role = a.required_role == "Reviewer" or a.required_role == "Admin"
    b_role = b.required_role == "Reviewer" or b.required_role == "Admin"
    c_role = c.required_role == "Reviewer" or c.required_role == "Admin"
    d_role = d.required_role == "Reviewer" or d.required_role == "Admin"
    e_role = e.required_role == "Admin"
    return a_role and b_role and c_role and d_role and e_role

# Case 6: all four scheduled jobs are in America/New_York and only
# fire on weekdays. Catches a cron change that accidentally fires
# the daily brief on Saturday at 7am.
agent case_all_scheduled_jobs_weekday_workday() -> Bool:
    brief = daily_brief_schedule()
    prep = meeting_prep_schedule()
    triage = email_triage_schedule()
    follow = follow_up_schedule()
    zones_ny = brief.time_zone == "America/New_York" and prep.time_zone == "America/New_York" and triage.time_zone == "America/New_York" and follow.time_zone == "America/New_York"
    brief_cron = brief.cron_expr == "0 7 * * 1-5"
    prep_cron = prep.cron_expr == "0 6 * * 1-5"
    triage_cron = triage.cron_expr == "*/10 8-18 * * 1-5"
    follow_cron = follow.cron_expr == "*/15 8-18 * * 1-5"
    return zones_ny and brief_cron and prep_cron and triage_cron and follow_cron

# Case 7: every job contract bounds budget at $0.75 and retries at
# 5 attempts. The two ceilings are the PEA's promise to the
# operator — the bar's `max_job_budget_usd` is a regression sentinel.
agent case_every_job_contract_bounded() -> Bool:
    bar = expected_maturity_bar()
    brief = daily_brief_job_contract()
    prep = meeting_prep_job_contract()
    triage = email_triage_job_contract()
    follow = follow_up_job_contract()
    budgets_ok = brief.budget_usd <= bar.max_job_budget_usd and prep.budget_usd <= bar.max_job_budget_usd and triage.budget_usd <= bar.max_job_budget_usd and follow.budget_usd <= bar.max_job_budget_usd
    attempts_ok = brief.max_attempts == 5 and prep.max_attempts == 5 and triage.max_attempts == 5 and follow.max_attempts == 5
    queues_ok = brief.queue_name == "personal_executive_agent" and prep.queue_name == "personal_executive_agent" and triage.queue_name == "personal_executive_agent" and follow.queue_name == "personal_executive_agent"
    return budgets_ok and attempts_ok and queues_ok

# Case 8: every job has a stable replay key. Replay keys are what
# the cross-layer quarantine (slices C-2 / C-3 / C-4 / C-5) uses to
# locate the per-job trace.
agent case_every_job_has_replay_key() -> Bool:
    brief = daily_brief_job_contract()
    prep = meeting_prep_job_contract()
    triage = email_triage_job_contract()
    follow = follow_up_job_contract()
    return brief.has_replay_key and prep.has_replay_key and triage.has_replay_key and follow.has_replay_key

# Case 9: connector default mode is mock. The adversarial fixture
# `adversarial/real_connector_default.json` enforces this at
# typecheck; this eval keeps the assertion in the runtime regression
# surface too.
agent case_connector_default_mode_is_mock() -> Bool:
    manifest = expected_manifest()
    return manifest.default_mode == "mock"

# Case 10: approval contract count meets the maturity bar AND the
# cross-product of every approval label appears exactly once
# (uniqueness check that catches duplicate-label drift).
agent case_approval_label_uniqueness() -> Bool:
    bar = expected_maturity_bar()
    manifest = expected_manifest()
    a = send_follow_up_email_approval()
    b = edit_calendar_event_approval()
    c = edit_task_item_approval()
    d = send_chat_message_approval()
    e = external_calendar_share_approval()
    ab = a.label != b.label
    ac = a.label != c.label
    ad = a.label != d.label
    ae = a.label != e.label
    bc = b.label != c.label
    bd = b.label != d.label
    be = b.label != e.label
    cd = c.label != d.label
    ce = c.label != e.label
    de = d.label != e.label
    distinct_pairs = ab and ac and ad and ae and bc and bd and be and cd and ce and de
    count_ok = manifest.approval_count >= bar.min_approvals
    return count_ok and distinct_pairs

eval executive_agent_per_app_maturity:
    assert case_schema_manifest_meets_maturity_bar()
    assert case_five_distinct_approval_contracts()
    assert case_every_approval_irreversible_and_short_expiry()
    assert case_approval_cost_ceilings_bounded()
    assert case_external_write_approvals_require_reviewer_or_admin()
    assert case_all_scheduled_jobs_weekday_workday()
    assert case_every_job_contract_bounded()
    assert case_every_job_has_replay_key()
    assert case_connector_default_mode_is_mock()
    assert case_approval_label_uniqueness()
