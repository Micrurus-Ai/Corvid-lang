# Corvid reference application — the Phase 52 continuous fixture.
#
# Every slice of Phase 52 extends this one file and proves the new
# runtime capability against it. It begins as a pure in-memory orders
# API exercising the three HTTP request shapes the runtime must
# execute end-to-end (slice 52a): a path parameter, a typed query
# struct, and a typed request body. Later slices grow it with data,
# connectors, background jobs, and deployment evidence — no host-
# language glue at any step.

type OrderView:
    id: String
    status: String
    total: Float

type OrderSummary:
    id: String
    status: String

type OrderPage:
    orders: List<OrderSummary>
    count: Int

type OrderFilter:
    status: String
    limit: Int

type NewOrder:
    item: String
    quantity: Int

type OrderReceipt:
    id: String
    accepted: Bool

type OrderEvent:
    id: String
    status: String

type OrderCursor:
    cursor: String
    limit: Int

type ImportReceipt:
    filename: String
    bytes: Int

type Carrier:
    name: String

type CarrierQuote:
    carrier: String

# The read effect the carrier lookup performs. The connector operation
# carries it so cost/effects compose through the same machinery every
# other call uses.
effect http_read:
    cost: $0.0

# A protocol-typed connector to a shipping carrier (slice 52g/52h). The
# operation is a normal typed HTTP call; `mock:` gives it an executable
# body so the reference app serves in `mock` mode with no live network
# and no credential. The deployment selects the mode with
# `corvid serve --mode mock`.
connector shipping:
    base_url: "https://carrier.example.com"
    modes: [mock, real]
    operation quote_carrier(zip: String) -> Carrier uses http_read:
        GET "/carriers/{zip}"
        mock: Carrier("mock-carrier")

# A streaming source: each yield becomes one Server-Sent Event.
agent order_activity() -> Stream<OrderEvent>:
    yield OrderEvent("order-1", "placed")
    yield OrderEvent("order-1", "picked")
    yield OrderEvent("order-1", "shipped")

server orders_api:
    # Path parameter → `path.id`.
    route GET "/orders/{id}" -> json OrderView:
        return OrderView(path.id, "open", 42.0)

    # Typed query struct → `query.status`, `query.limit`.
    route GET "/orders" query OrderFilter -> json OrderPage:
        summary = OrderSummary("order-1", query.status)
        return OrderPage([summary], query.limit)

    # Typed request body → `body.item`, `body.quantity`.
    route POST "/orders" body NewOrder -> json OrderReceipt:
        return OrderReceipt("order-new", true)

    # Streaming response → Server-Sent Events (slice 52c-1). The
    # `Stream<OrderEvent>` return makes `corvid serve` flush each
    # yielded event as `data: <json>`, then `event: done`.
    route GET "/orders/activity" -> json Stream<OrderEvent>:
        return order_activity()

    # Cursor pagination → the `{items, next_cursor, has_more}` envelope
    # (slice 52c-2). `Page(items, next_cursor)` derives `has_more`; the
    # incoming cursor is read from the typed query struct.
    route GET "/orders/page" query OrderCursor -> json Page<OrderSummary>:
        first = OrderSummary("order-1", "open")
        second = OrderSummary("order-2", "shipped")
        return Page([first, second], Some(query.cursor))

    # File upload → multipart parsing with accepted-MIME + max-size
    # enforcement (slice 52c-2); the file is read via `body.filename()`
    # / `body.size()` / `body.text()`.
    @upload(max_mb: 25)
    route POST "/orders/import" body Upload<Csv> -> json ImportReceipt:
        return ImportReceipt(body.filename(), body.size())

    # A route that calls a connector operation (slice 52g/52h). It
    # forces `corvid serve` to actually execute the connector in the
    # deployment-selected mode — the composition the 52h audit found
    # missing. In `mock` mode this returns the connector's compiled
    # `mock:` payload with no network and no credential.
    route GET "/orders/{id}/carrier" -> json CarrierQuote:
        carrier = quote_carrier(path.id)
        return CarrierQuote(carrier.name)

agent main() -> String:
    return "orders_api reference application"
