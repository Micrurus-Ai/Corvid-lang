import "std:ui" as ui

choice RunMode:
    Manual
    Scheduled

type AgentProfile:
    name: String where len_between(1, 60)

type AgentTools:
    web_search: Bool

type AgentSettings:
    profile: AgentProfile
    tools: AgentTools
    mode: RunMode
    interval_minutes: Int where between(1, 60)
    retries: Int where between(0, 5)

fn settings_panel(children: List<ui.View>) -> ui.View:
    return ui.grid(children)

fn preview_row(label: String, content: ui.View) -> ui.View:
    return ui.row:
        ui.text(label)
        content

fn agent_card(name: ui.View, mode: ui.View, search: ui.View, retries: ui.View) -> ui.View:
    return ui.stack:
        preview_row("Agent name", name)
        preview_row("Run mode", mode)
        preview_row("Web search", search)
        preview_row("Retry limit", retries)

fn settings_editor(initial: AgentSettings) -> ui.View:
    browser state settings = initial
    controls = settings_panel:
        ui.field("Agent name", bind settings.profile.name)
        ui.checkbox("Allow web search", bind settings.tools.web_search)
        ui.segmented_choice("Run mode", bind settings.mode)
        if settings.mode == Scheduled:
            ui.field("Interval in minutes", bind settings.interval_minutes)
        ui.field("Retry limit", bind settings.retries)
    preview = agent_card(
        ui.value(bind settings.profile.name),
        ui.value(bind settings.mode),
        ui.value(bind settings.tools.web_search),
        ui.value(bind settings.retries)
    )
    return ui.local_selection(settings, controls, preview)

server app:
    route GET "/" -> html:
        editor = settings_editor(AgentSettings(AgentProfile("Assistant"), AgentTools(false), Manual, 5, 1))
        return ui.interactive_page("Agent settings", [ui.assistant_selection(editor, "update_settings", "Update the agent settings.")])
