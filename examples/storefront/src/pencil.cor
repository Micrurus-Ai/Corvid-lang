import "./layout" use shop_page
import "./color_picker" use ColorPicker, Color, color_name
import "std:ui" as ui
import "std:ui" use View

public fn pencil_finish(value: Color) -> String:
    return shop_page("Pencil finish", [ui.link("Catalog", "/"), View("<h1>Pencil finish</h1>"), ui.text("Barrel color: " + color_name(value)), ui.text("Selecting a color updates the preview."), ColorPicker(value, "/pencil"), ui.event_module()])
